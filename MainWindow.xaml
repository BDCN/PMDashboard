<Window x:Class="PMDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PMDashboard.ViewModels"
        Title="SAT - Site Assignment Tracker" Height="820" Width="1400"
        Icon="favicon.ico"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>   <!-- Application header with IEM logo -->
            <RowDefinition Height="*"/>    <!-- Sidebar + page content -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════════
             Application Header — white background matches the logo's
             white background so no seam is visible around the image.
             ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid Margin="16,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- Logo -->
                    <ColumnDefinition Width="*"/>     <!-- Spacer -->
                    <ColumnDefinition Width="Auto"/>  <!-- Last updated -->
                    <ColumnDefinition Width="Auto"/>  <!-- Signed-in user -->
                    <ColumnDefinition Width="Auto"/>  <!-- App name -->
                </Grid.ColumnDefinitions>

                <!-- IEM logo — white background is invisible against the white header -->
                <Image Grid.Column="0"
                       Source="/PMDashboard;component/Assets/iem-logo.png"
                       Height="40"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       SnapsToDevicePixels="True"/>

                <!-- Last updated — refreshed whenever a sync pull/push completes -->
                <TextBlock x:Name="TxtLastUpdated" Grid.Column="2" FontSize="11" Foreground="#94A3B8"
                           VerticalAlignment="Center" Margin="0,0,18,0"/>

                <!-- Signed-in user — opens the profile -->
                <Button Grid.Column="3" Click="BtnProfile_Click" Cursor="Hand"
                        Background="Transparent" BorderThickness="0" Padding="10,4"
                        Margin="0,0,18,0" VerticalAlignment="Center"
                        ToolTipService.ToolTip="View or edit your profile">
                    <StackPanel>
                        <TextBlock x:Name="TxtCurrentUser" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#0F172A" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="TxtCurrentUserRole" FontSize="10" Foreground="#94A3B8"
                                   HorizontalAlignment="Right" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <!-- App name + subtitle -->
                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <TextBlock Text="SAT"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="#0F172A"
                               HorizontalAlignment="Right"/>
                    <TextBlock Text="Site Assignment Tracker"
                               FontSize="10" Foreground="#94A3B8"
                               HorizontalAlignment="Right" Margin="0,3,0,0"/>
                    <!-- Version (Services/AppVersion.cs) — set in MainWindow.xaml.cs; tooltip has the build time -->
                    <TextBlock x:Name="TxtAppVersion"
                               FontSize="10" Foreground="#94A3B8"
                               HorizontalAlignment="Right" Margin="0,1,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             Sidebar + main content
             ══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="220" MinWidth="0"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Sidebar ── -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- toggle row -->
                        <RowDefinition Height="*"/>      <!-- nav content -->
                    </Grid.RowDefinitions>

                    <!-- Toggle button — always visible -->
                    <Button Grid.Row="0" x:Name="BtnToggleSidebar"
                            Content="«" FontSize="16" Foreground="#94A3B8"
                            Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="44" Height="44" Cursor="Hand"
                            Click="BtnToggleSidebar_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#334155"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Expanded nav content (branding removed — now in top header) -->
                    <DockPanel Grid.Row="1" x:Name="SidebarContent" LastChildFill="True">

                        <!-- ── Cloud sync indicator — pinned to the bottom of the sidebar via
                             DockPanel.Dock="Bottom" (everything else above is "Top", so this is
                             the only element anchored to the bottom edge regardless of how much
                             nav content there is). Hidden entirely outside Cloud mode — Local
                             and Network modes have nothing here to report on. Driven from
                             code-behind (UpdateSyncIndicator) off CloudSyncService's
                             ProgressChanged/StatusChanged events, same pattern as TxtLastUpdated
                             in the header. ── -->
                        <StackPanel x:Name="SyncIndicator" DockPanel.Dock="Bottom"
                                    Margin="16,12,16,16" Visibility="Collapsed">
                            <Separator Background="#334155" Margin="0,0,0,12"/>

                            <!-- Actively syncing: label + percent + bar + ETA -->
                            <StackPanel x:Name="SyncActivePanel" Visibility="Collapsed">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="☁" FontSize="11" Foreground="#60A5FA" Margin="0,0,6,0"/>
                                        <TextBlock Text="Syncing…" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtSyncPercent" Grid.Column="1" Text="0%"
                                               FontSize="11" Foreground="#94A3B8"/>
                                </Grid>
                                <!-- Fill width via star-sized Grid columns (ColFill/ColRest), not a fixed-pixel
                                     Border — lets WPF's layout engine handle proportional sizing natively
                                     instead of hand-tracking the container's pixel width on every resize. -->
                                <Border Background="#334155" CornerRadius="3" Height="6" Margin="0,0,0,6" ClipToBounds="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="ColFill" Width="0*"/>
                                            <ColumnDefinition x:Name="ColRest" Width="100*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#3B82F6"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="TxtSyncEta" Text="" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>

                            <!-- Idle: compact "last synced" line + manual sync-now button —
                                 for exactly this kind of "has it actually pushed yet?"
                                 troubleshooting, instead of waiting out the ~30s periodic tick. -->
                            <Grid x:Name="SyncIdlePanel">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="☁" FontSize="11" Foreground="#4ADE80" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="TxtSyncIdle" Text="Synced" FontSize="11" Foreground="#94A3B8"/>
                                </StackPanel>
                                <Button x:Name="BtnSyncNow" Grid.Column="1" Content="⟳ Sync Now"
                                        FontSize="10" Foreground="#93C5FD" Background="Transparent"
                                        BorderThickness="0" Padding="0" Cursor="Hand"
                                        Click="BtnSyncNow_Click" ToolTip="Sync with the cloud right now"/>
                            </Grid>
                        </StackPanel>


                        <!-- Everything above the sync indicator scrolls, so short screens can still
                             reach every page and the region filter. The sync status stays pinned. -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="VerticalOnly">
                            <ScrollViewer.Resources>
                                <!-- Slim dark scrollbar to match the sidebar -->
                                <Style TargetType="ScrollBar">
                                    <Setter Property="Width" Value="8"/>
                                    <Setter Property="MinWidth" Value="8"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ScrollBar">
                                                <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,2,2,2">
                                                    <Track.Thumb>
                                                        <Thumb>
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Border Background="#475569" CornerRadius="3"/>
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                    </Track.Thumb>
                                                </Track>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ScrollViewer.Resources>
                            <StackPanel Margin="0,0,0,12">
                            <Separator Background="#334155" Margin="16,8,16,16"/>

                            <TextBlock Text="NAVIGATION" FontSize="10"
                                       Foreground="#475569" FontWeight="SemiBold"
                                       Margin="20,0,0,10"/>

                            <!-- Nav items -->
                            <StackPanel Margin="10,0">
                                <RadioButton x:Name="NavWorkload" Content="⬤  Workload"
                                             GroupName="Nav"
                                             Style="{StaticResource NavButtonStyle}"
                                             IsChecked="True"
                                             Click="NavWorkload_Click"/>
                                <RadioButton x:Name="NavAssignment" Content="⬤  Assignment"
                                             GroupName="Nav"
                                             Style="{StaticResource NavButtonStyle}"
                                             Click="NavAssignment_Click"/>
                                <RadioButton x:Name="NavSites" Content="⬤  Sites"
                                             GroupName="Nav"
                                             Style="{StaticResource NavButtonStyle}"
                                             Click="NavSites_Click"/>
                                <RadioButton x:Name="NavPm" Content="⬤  PM Maintenance"
                                             GroupName="Nav"
                                             Style="{StaticResource NavButtonStyle}"
                                             Click="NavPm_Click"/>
                                <RadioButton x:Name="NavTeams" Content="⬤  Teams"
                                             GroupName="Nav"
                                             Style="{StaticResource NavButtonStyle}"
                                             Click="NavTeams_Click"/>
                                <RadioButton x:Name="NavOrgChart" Content="⬤  Org Chart"
                                             GroupName="Nav"
                                             Style="{StaticResource NavButtonStyle}"
                                             Click="NavOrgChart_Click"/>
                                <RadioButton x:Name="NavReportBuilder" Content="⬤  Report Builder"
                                             GroupName="Nav"
                                             Style="{StaticResource NavButtonStyle}"
                                             Click="NavReportBuilder_Click"/>
                                <RadioButton x:Name="NavCustomData" Content="⬤  Custom Data"
                                             GroupName="Nav"
                                             Style="{StaticResource NavButtonStyle}"
                                             Click="NavCustomData_Click"/>
                                <RadioButton x:Name="NavOrders" Content="⬤  Orders (Import)"
                                             GroupName="Nav"
                                             Style="{StaticResource NavButtonStyle}"
                                             Click="NavOrders_Click"/>
                                <RadioButton x:Name="NavForecastPlanning" Content="⬤  Forecast Planning"
                                             GroupName="Nav"
                                             Style="{StaticResource NavButtonStyle}"
                                             Click="NavForecastPlanning_Click"/>
                                <RadioButton x:Name="NavForecastTimeline" Content="⬤  Forecast Timeline"
                                             GroupName="Nav"
                                             Style="{StaticResource NavButtonStyle}"
                                             Click="NavForecastTimeline_Click"/>
                                <RadioButton x:Name="NavCoveragePlanner" Content="⬤  Coverage Planner"
                                             GroupName="Nav"
                                             Style="{StaticResource NavButtonStyle}"
                                             Click="NavCoveragePlanner_Click"/>
                            </StackPanel>

                            <!-- Config separator + item -->
                            <Separator Background="#334155" Margin="16,16,16,0"/>
                            <TextBlock Text="CONFIG" FontSize="10"
                                       Foreground="#475569" FontWeight="SemiBold"
                                       Margin="20,12,0,6"/>
                            <StackPanel Margin="10,0">
                                <RadioButton x:Name="NavUserManagement" Content="⬤  User Management"
                                             GroupName="Nav"
                                             Style="{StaticResource NavButtonStyle}"
                                             Click="NavUserManagement_Click"/>
                                <RadioButton x:Name="NavConfig" Content="⬤  Configuration"
                                             GroupName="Nav"
                                             Style="{StaticResource NavButtonStyle}"
                                             Click="NavConfig_Click"/>
                            </StackPanel>

                            <!-- Filter separator -->
                            <Separator Background="#334155" Margin="16,12,16,0"/>

                            <!-- Geographic filter -->
                            <StackPanel Margin="16,12,16,0">
                                <TextBlock Text="GEOGRAPHIC LOCATION" FontSize="9" FontWeight="SemiBold"
                                           Foreground="#475569" Margin="4,0,0,8"/>
                                <ComboBox x:Name="CboGeoFilter"
                                          Style="{StaticResource FormComboBoxStyle}"
                                          SelectionChanged="CboGeoFilter_SelectionChanged">
                                    <ComboBoxItem Content="All" IsSelected="True"/>
                                    <ComboBoxItem Content="East"/>
                                    <ComboBoxItem Content="Central"/>
                                    <ComboBoxItem Content="West"/>
                                </ComboBox>
                            </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- ── Main content ── -->
            <ContentControl Grid.Column="1" x:Name="MainContent"
                            Content="{Binding CurrentPage}"
                            Background="{StaticResource ContentBgBrush}"/>

            <!-- ── Outdated-version banner — shown when another machine reported a newer version
                 (CloudSyncService.NewerVersionInUse). Persistent until dismissed, unlike the toast. ── -->
            <Border x:Name="UpdateBanner" Grid.Column="1"
                    Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1"
                    CornerRadius="8" Padding="14,10"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,16,24,0" MaxWidth="460" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Click="BtnDismissUpdateBanner_Click"
                            Background="Transparent" BorderThickness="0" Foreground="#92400E"
                            Cursor="Hand" Padding="6,0" Margin="10,0,0,0" VerticalAlignment="Top"
                            ToolTip="Dismiss"/>
                    <TextBlock x:Name="TxtUpdateBanner" Foreground="#92400E" FontSize="12"
                               TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <!-- ── Notification toast — non-modal, auto-dismisses; see MainWindow.xaml.cs ── -->
            <Border x:Name="ToastBorder" Grid.Column="1"
                    Background="#1E293B" CornerRadius="8" Padding="16,12"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,24,24" Visibility="Collapsed"
                    MaxWidth="360" IsHitTestVisible="False">
                <TextBlock x:Name="TxtToast" Foreground="White" FontSize="12"
                           TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Grid>
</Window>
