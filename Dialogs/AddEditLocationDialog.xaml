<Window x:Class="PMDashboard.Dialogs.AddEditLocationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Location Details"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Border Padding="28">
        <StackPanel>
            <TextBlock x:Name="TxtTitle" Text="Add Location" FontSize="18"
                       FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,24"/>

            <TextBlock Text="Location Code" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtName" Style="{StaticResource FormTextBoxStyle}"
                     CharacterCasing="Upper" Margin="0,0,0,6"
                     LostFocus="TxtName_LostFocus"/>
            <!-- Airport lookup hint -->
            <TextBlock x:Name="TxtAirportHint" FontSize="11" Margin="0,0,0,10"
                       TextWrapping="Wrap" Foreground="#64748B"
                       Text="3-letter airport code (e.g. IAD, ATL, LAX, GRU) — region is auto-detected"/>

            <TextBlock Text="Geographical Location" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <ComboBox x:Name="CboRegion" Style="{StaticResource FormComboBoxStyle}"
                      Margin="0,0,0,24">
                <ComboBoxItem Content="East"/>
                <ComboBoxItem Content="Central"/>
                <ComboBoxItem Content="West"/>
            </ComboBox>

            <!-- Close shortcut — completes every ROMP at every Site under this location (edit only) -->
            <Border x:Name="CloseLocationSection" Visibility="Collapsed"
                    Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                    CornerRadius="6" Padding="14,12" Margin="0,0,0,20">
                <StackPanel>
                    <CheckBox x:Name="ChkCloseAll" Content="Close All Sites &amp; This Location"
                              FontSize="12" FontWeight="SemiBold" Foreground="#B91C1C"
                              Margin="0,0,0,4"/>
                    <TextBlock Text="Marks every ROMP at every Site under this location complete, and hides the location, its sites, and their ROMPs from their lists — the data stays for reporting/scoring history. Use &quot;Show Completed&quot; to find them again."
                               FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="TxtError" Foreground="#EF4444" FontSize="12"
                       Visibility="Collapsed" Margin="0,0,0,12" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnCancel_Click" Margin="0,0,10,0"/>
                <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
