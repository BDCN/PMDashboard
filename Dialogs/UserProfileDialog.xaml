<Window x:Class="PMDashboard.Dialogs.UserProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Profile"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Border Padding="28">
        <StackPanel>
            <TextBlock Text="My Profile" FontSize="18" FontWeight="SemiBold"
                       Foreground="#0F172A" Margin="0,0,0,2"/>
            <TextBlock x:Name="TxtRole" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,20"/>

            <TextBlock Text="First name" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtFirstName" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,14"/>

            <TextBlock Text="Last name" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtLastName" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,14"/>

            <TextBlock Text="Email address (used to sign in)" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtEmail" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,14"/>

            <TextBlock x:Name="TxtStatus" FontSize="12" TextWrapping="Wrap"
                       Visibility="Collapsed" Margin="0,0,0,10"/>

            <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Change Password" Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnChangePassword_Click" Padding="12,6" FontSize="12"/>
                    <TextBlock x:Name="TxtLastLogin" FontSize="11" Foreground="#94A3B8"
                               VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Close" Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnClose_Click" Margin="0,0,10,0"/>
                <Button Content="Save Profile" Style="{StaticResource PrimaryButtonStyle}"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
