<Window x:Class="PMDashboard.Dialogs.UserProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Your Profile"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Border Padding="28">
        <StackPanel>
            <TextBlock Text="Your Profile" FontSize="18" FontWeight="SemiBold"
                       Foreground="#0F172A" Margin="0,0,0,4"/>
            <TextBlock x:Name="TxtRole" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
            <TextBlock x:Name="TxtLastLogin" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,20"/>

            <TextBlock Text="First Name" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtFirstName" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,14"/>

            <TextBlock Text="Last Name" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtLastName" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,14"/>

            <TextBlock Text="Email" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtEmail" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,8"/>

            <TextBlock x:Name="TxtStatus" FontSize="12"
                       Visibility="Collapsed" Margin="0,0,0,12" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Change Password" Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnChangePassword_Click" Margin="0,0,10,0"/>
                <Button Content="Close" Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnClose_Click" Margin="0,0,10,0"/>
                <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
