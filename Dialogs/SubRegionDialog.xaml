<Window x:Class="PMDashboard.Dialogs.SubRegionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sub-region"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Border Padding="28">
        <StackPanel>
            <TextBlock x:Name="TxtTitle" Text="Add Sub-region" FontSize="18"
                       FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,18"/>

            <TextBlock Text="Region" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
            <ComboBox x:Name="CboRegion" IsEditable="True" Style="{StaticResource FormComboBoxStyle}" Margin="0,0,0,12"/>

            <TextBlock Text="Name" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtName" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,6"/>
            <TextBlock Text="e.g. East 1" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,12"/>

            <TextBlock x:Name="TxtError" Foreground="#EF4444" FontSize="12" TextWrapping="Wrap"
                       Visibility="Collapsed" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnCancel_Click" Margin="0,0,10,0"/>
                <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
