<Window x:Class="PMDashboard.Dialogs.AddEditUserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add User"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Border Padding="28">
        <StackPanel>
            <TextBlock Text="Add User" FontSize="18" FontWeight="SemiBold"
                       Foreground="#0F172A" Margin="0,0,0,4"/>
            <TextBlock Text="Create a login for a new team member. They'll be asked to set their own password on first sign-in."
                       FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,18"/>

            <TextBlock Text="First Name" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtFirstName" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,14"/>

            <TextBlock Text="Last Name" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtLastName" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,14"/>

            <TextBlock Text="Email Address" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtEmail" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,14"/>

            <TextBlock Text="Role" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <ComboBox x:Name="CmbRole" Style="{StaticResource FormComboBoxStyle}" Margin="0,0,0,14"
                      SelectedIndex="0">
                <ComboBoxItem Content="User"/>
                <ComboBoxItem Content="Director"/>
                <ComboBoxItem x:Name="ItemSuperAdmin" Content="SuperAdmin"/>
            </ComboBox>

            <TextBlock Text="Initial Password" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <PasswordBox x:Name="PwdInitial" Style="{StaticResource FormPasswordBoxStyle}" Margin="0,0,0,4"/>
            <TextBlock Text="At least 8 characters. They'll be asked to change it on first sign-in."
                       FontSize="11" Foreground="#94A3B8" Margin="0,0,0,8" TextWrapping="Wrap"/>

            <TextBlock x:Name="TxtError" Foreground="#EF4444" FontSize="12"
                       Visibility="Collapsed" Margin="0,0,0,12" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnCancel_Click" Margin="0,0,10,0"/>
                <Button Content="Create User" Style="{StaticResource PrimaryButtonStyle}"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
