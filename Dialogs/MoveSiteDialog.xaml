<Window x:Class="PMDashboard.Dialogs.MoveSiteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Move Site" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Border Padding="28">
        <StackPanel>
            <TextBlock x:Name="TxtHeading" Text="Move Site" FontSize="16" FontWeight="SemiBold"
                       Foreground="#0F172A" Margin="0,0,0,6"/>
            <TextBlock x:Name="TxtPrompt" FontSize="13" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,16"
                       Text="Choose the campus this site belongs to. Its ROMPs move with it."/>

            <TextBlock Text="Campus" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
            <!-- Editable: pick an existing campus in this cluster, or type a new name to create one -->
            <ComboBox x:Name="CboCampus" IsEditable="True" IsTextSearchEnabled="True"
                      DisplayMemberPath="Name" FontSize="13" Padding="8,6" Margin="0,0,0,6"/>
            <TextBlock Text="Type a name that isn't in the list to create a new campus in this cluster."
                       FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <TextBlock x:Name="TxtPmNote" FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,8"/>

            <TextBlock x:Name="TxtError" Text="Choose or type a campus."
                       Foreground="#EF4444" FontSize="12"
                       Visibility="Collapsed" Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnCancel_Click" Margin="0,0,10,0"/>
                <Button Content="Move" Style="{StaticResource PrimaryButtonStyle}"
                        Click="BtnOk_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
