<Window x:Class="PMDashboard.Dialogs.SelectForecastTypeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Forecast Type"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Border Padding="28">
        <StackPanel>
            <TextBlock Text="Confirm Forecast Type" FontSize="18" FontWeight="SemiBold"
                       Foreground="#0F172A" Margin="0,0,0,4"/>
            <TextBlock x:Name="TxtMessage" FontSize="12" Foreground="#64748B"
                       TextWrapping="Wrap" Margin="0,0,0,16"/>

            <TextBlock Text="Type" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <ComboBox x:Name="CmbType" Style="{StaticResource FormComboBoxStyle}"
                      DisplayMemberPath="Name" Margin="0,0,0,16"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnCancel_Click" Margin="0,0,10,0"/>
                <Button Content="Import" Style="{StaticResource PrimaryButtonStyle}"
                        Click="BtnOk_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
