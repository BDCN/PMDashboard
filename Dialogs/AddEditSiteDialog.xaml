<Window x:Class="PMDashboard.Dialogs.AddEditSiteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Site Details"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Border Padding="28">
        <StackPanel>
            <TextBlock x:Name="TxtTitle" Text="Add Site" FontSize="18"
                       FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,24"/>

            <!-- Cluster -->
            <TextBlock Text="Cluster" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <ComboBox x:Name="CboLocation" Style="{StaticResource FormComboBoxStyle}"
                      DisplayMemberPath="Name" Margin="0,0,0,8"/>
            <TextBlock x:Name="TxtRegionHint" Text="" FontSize="11"
                       Foreground="#64748B" Margin="0,0,0,16"/>

            <!-- Campus Name -->
            <TextBlock Text="Site Name" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtName" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,24"/>

            <!-- Bulk ROMP Status (edit only — hidden for new sites) -->
            <Border x:Name="BulkRompSection" Visibility="Collapsed"
                    Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                    CornerRadius="6" Padding="14,12" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Set All ROMPs to Status" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#374151"/>
                        <Border Background="#FEF9C3" BorderBrush="#FDE68A" BorderThickness="1"
                                CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Optional" FontSize="10" Foreground="#92400E" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Leaves individual ROMP statuses unchanged if set to No change."
                               FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <!-- Current status breakdown — set in code-behind; hidden if there are no ROMPs yet -->
                    <TextBlock x:Name="TxtCurrentStatuses" FontSize="11" FontWeight="SemiBold"
                               Foreground="#374151" TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="Collapsed"/>
                    <!-- Items loaded dynamically from StatusConfig in code-behind -->
                    <ComboBox x:Name="CboBulkRompStatus" Style="{StaticResource FormComboBoxStyle}"/>
                </StackPanel>
            </Border>

            <!-- Close shortcut — completes every ROMP at this campus and hides it from the list -->
            <Border x:Name="CloseSiteSection" Visibility="Collapsed"
                    Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                    CornerRadius="6" Padding="14,12" Margin="0,0,0,20">
                <StackPanel>
                    <CheckBox x:Name="ChkCloseAll" Content="Close All ROMPs &amp; This Site"
                              FontSize="12" FontWeight="SemiBold" Foreground="#B91C1C"
                              Margin="0,0,0,4"/>
                    <TextBlock Text="Marks every ROMP at this site complete and hides the site from the list — the data stays for reporting/scoring history. Use &quot;Show Completed&quot; on the Sites list to find it again."
                               FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Error -->
            <TextBlock x:Name="TxtError" Foreground="#EF4444" FontSize="12"
                       Visibility="Collapsed" Margin="0,0,0,12" TextWrapping="Wrap"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnCancel_Click" Margin="0,0,10,0"/>
                <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
