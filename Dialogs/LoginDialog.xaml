<Window x:Class="PMDashboard.Dialogs.LoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign In — SAT"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Border Padding="28">
        <StackPanel>
            <TextBlock Text="SAT" FontSize="20" FontWeight="Bold"
                       Foreground="#0F172A" Margin="0,0,0,4"/>
            <TextBlock Text="Site Assignment Tracker  ·  Sign in to continue"
                       FontSize="13" Foreground="#64748B" Margin="0,0,0,20"/>

            <TextBlock Text="Email" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtEmail" Style="{StaticResource FormTextBoxStyle}"
                     Margin="0,0,0,14" KeyDown="Field_KeyDown"/>

            <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <PasswordBox x:Name="PwdBox" Style="{StaticResource FormPasswordBoxStyle}"
                         Margin="0,0,0,8" KeyDown="Field_KeyDown"/>

            <TextBlock x:Name="TxtError" Foreground="#EF4444" FontSize="12"
                       Visibility="Collapsed" Margin="0,0,0,12" TextWrapping="Wrap"/>

            <CheckBox x:Name="ChkSkipLogin" Content="Skip login on this computer (dev only)"
                      FontSize="12" Foreground="#374151" Margin="0,0,0,4"/>
            <TextBlock Text="Anyone using this Windows account on this PC will sign in as you automatically — only enable this on your own development machine."
                       FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,4"/>

            <!-- Which database this computer uses; anyone can connect it to the shared one
                 (Dialogs/DatabaseConnectFlow) — no admin rights needed. -->
            <Border Background="#F1F5F9" CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock x:Name="TxtDatabase" FontSize="11" Foreground="#475569" TextWrapping="Wrap"/>
                    <Button x:Name="BtnConnectDb" Content="Connect to network database…"
                            HorizontalAlignment="Left" Margin="0,4,0,0"
                            FontSize="11" Foreground="#2563EB" Background="Transparent"
                            BorderThickness="0" Padding="0" Cursor="Hand"
                            Click="BtnConnectDb_Click"/>
                </StackPanel>
            </Border>

            <DockPanel Margin="0,12,0,0" LastChildFill="False">
                <TextBlock x:Name="TxtVersion" DockPanel.Dock="Left" FontSize="10" Foreground="#94A3B8"
                           VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnCancel_Click" Margin="0,0,10,0"/>
                    <Button x:Name="BtnSignIn" Content="Sign In" Style="{StaticResource PrimaryButtonStyle}"
                            Click="BtnSignIn_Click"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
