<Window x:Class="PMDashboard.Dialogs.LoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign In - PM Dashboard"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Border Padding="32">
        <StackPanel>
            <TextBlock Text="PM Dashboard" FontSize="20" FontWeight="Bold"
                       Foreground="#0F172A" Margin="0,0,0,2"/>
            <TextBlock Text="Sign in to continue" FontSize="13" Foreground="#64748B"
                       Margin="0,0,0,22"/>

            <TextBlock Text="Email address" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtEmail" Style="{StaticResource FormTextBoxStyle}"
                     Margin="0,0,0,14" KeyDown="Field_KeyDown"/>

            <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <PasswordBox x:Name="PwdBox"
                         BorderBrush="#D1D5DB" BorderThickness="1"
                         Padding="10,8" FontSize="13" Background="White" Foreground="#111827"
                         Margin="0,0,0,10" KeyDown="Field_KeyDown"/>

            <Border x:Name="WarnBanner" Background="#FEF9C3" BorderBrush="#FDE68A"
                    BorderThickness="1" CornerRadius="6" Padding="10,8"
                    Visibility="Collapsed" Margin="0,0,0,12">
                <TextBlock x:Name="TxtWarn" FontSize="11" Foreground="#92400E" TextWrapping="Wrap"/>
            </Border>

            <TextBlock x:Name="TxtError" Foreground="#EF4444" FontSize="12"
                       TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Exit" Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnCancel_Click" Margin="0,0,10,0"/>
                <Button Content="Sign In" Style="{StaticResource PrimaryButtonStyle}"
                        Click="BtnSignIn_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
