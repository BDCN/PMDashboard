<Window x:Class="PMDashboard.Dialogs.PmReassignmentPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Current Assignments"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Border Padding="28">
        <StackPanel>
            <TextBlock x:Name="TxtTitle" Text="This PM has current assignments" FontSize="18"
                       FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,8"/>
            <TextBlock x:Name="TxtSummary" FontSize="13" Foreground="#64748B"
                       TextWrapping="Wrap" Margin="0,0,0,20"/>

            <Button Content="Assign to Another PM…" Style="{StaticResource PrimaryButtonStyle}"
                    Padding="14,10" Margin="0,0,0,10" Click="BtnReassign_Click"/>
            <Button Content="Unassign These Sites/ROMPs" Style="{StaticResource SecondaryButtonStyle}"
                    Padding="14,10" Margin="0,0,0,10" Click="BtnUnassign_Click"/>
            <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                    Padding="14,10" Click="BtnCancel_Click"/>
        </StackPanel>
    </Border>
</Window>
