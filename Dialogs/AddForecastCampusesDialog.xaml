<Window x:Class="PMDashboard.Dialogs.AddForecastCampusesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Sites from Forecast Data"
        Width="640" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- New clusters section -->
            <RowDefinition Height="*"/>     <!-- Campus list -->
            <RowDefinition Height="Auto"/>  <!-- Buttons -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Add Sites from Forecast Data" FontSize="18" FontWeight="SemiBold"
                       Foreground="#0F172A"/>
            <TextBlock Text="These Site Codes appear in your forecast uploads but don't exist as real sites yet. Select which ones to create."
                       FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- New clusters needing a region — usually just one or two -->
        <Border x:Name="NewClustersPanel" Grid.Row="1" Background="#FFFBEB" BorderBrush="#FDE68A"
                BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="New clusters — choose a region for each before adding their sites:"
                           FontSize="12" FontWeight="SemiBold" Foreground="#92400E" Margin="0,0,0,8"/>
                <ItemsControl x:Name="NewClustersList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding ClusterCode}" FontWeight="SemiBold"
                                           Foreground="#0F172A" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding RegionOptions}"
                                          SelectedItem="{Binding SelectedRegion, Mode=TwoWay}"
                                          VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding CampusCountLabel}" FontSize="11"
                                           Foreground="#64748B" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Campus checklist -->
        <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Background="White">
            <DataGrid x:Name="CampusGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      RowHeight="30" BorderThickness="0" IsReadOnly="False">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Add" Binding="{Binding IsSelected}" Width="50"/>
                    <DataGridTextColumn Header="Site Code" Binding="{Binding SiteCode}" Width="160" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Cluster" Binding="{Binding ClusterCode}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="*" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock x:Name="TxtError" Foreground="#DC2626" FontSize="12" VerticalAlignment="Center"
                       Margin="0,0,16,0"/>
            <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                    Padding="16,9" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button x:Name="BtnAdd" Content="Add Selected" Style="{StaticResource PrimaryButtonStyle}"
                    Padding="16,9" Click="BtnAdd_Click"/>
        </StackPanel>
    </Grid>
</Window>
