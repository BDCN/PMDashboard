<Window x:Class="PMDashboard.Dialogs.AddEditPmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PM Details"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Border Padding="28">
        <StackPanel>

            <TextBlock x:Name="TxtTitle" Text="Add PM" FontSize="18"
                       FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,24"/>

            <!-- Name row -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="First Name" FontSize="12" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtFirstName" Style="{StaticResource FormTextBoxStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Last Name" FontSize="12" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtLastName" Style="{StaticResource FormTextBoxStyle}"/>
                </StackPanel>
            </Grid>

            <!-- Home Office + Geographical Location row -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Home Office" FontSize="12" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CboHomeOffice" Style="{StaticResource FormComboBoxStyle}">
                        <ComboBoxItem Content="FRE"/>
                        <ComboBoxItem Content="VAN"/>
                        <ComboBoxItem Content="JAX"/>
                        <ComboBoxItem Content="Remote"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Geographical Location" FontSize="12" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CboGeoLocation" Style="{StaticResource FormComboBoxStyle}">
                        <ComboBoxItem Content="East"/>
                        <ComboBoxItem Content="Central"/>
                        <ComboBoxItem Content="West"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Data Name -->
            <TextBlock Text="Data Name" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtDataName" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,16"/>

            <!-- Capacity & Ideal Utilization — hidden entirely in Site Count Only mode -->
            <Grid x:Name="CapacityRow" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Capacity" FontSize="12" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtCapacity" Style="{StaticResource FormTextBoxStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Ideal Utilization (%)" FontSize="12" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtIdealUtil" Style="{StaticResource FormTextBoxStyle}"/>
                </StackPanel>
            </Grid>

            <!-- PM Multiplier — hidden entirely in Site Count Only mode -->
            <StackPanel x:Name="PmMultiplierPanel" Margin="0,0,0,24">
                <TextBlock Text="PM Multiplier (1–10)" FontSize="12" FontWeight="SemiBold"
                           Foreground="#374151" Margin="0,0,0,6"
                           ToolTipService.ToolTip="Experience rating 1–10. Scales effective capacity in Score mode. Leave blank to use the 1.0 factor (same as 10)."/>
                <TextBox x:Name="TxtPmMultiplier" Style="{StaticResource FormTextBoxStyle}"/>
            </StackPanel>

            <!-- Active status -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                    CornerRadius="6" Padding="14,12" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Status" FontSize="12" FontWeight="SemiBold" Foreground="#374151"/>
                        <TextBlock Text="Inactive PMs are hidden from the Workload chart."
                                   FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="ChkActive" Grid.Column="1"
                              Content="Active" FontSize="13" FontWeight="SemiBold"
                              Foreground="#16A34A" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <TextBlock x:Name="TxtError" Foreground="#EF4444" FontSize="12"
                       Visibility="Collapsed" Margin="0,0,0,12" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnCancel_Click" Margin="0,0,10,0"/>
                <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}"
                        Click="BtnSave_Click"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
