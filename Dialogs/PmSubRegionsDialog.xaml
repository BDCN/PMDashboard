<Window x:Class="PMDashboard.Dialogs.PmSubRegionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sub-regions"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Border Padding="28">
        <StackPanel>
            <TextBlock x:Name="TxtTitle" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,6"/>
            <TextBlock FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,16"
                       Text="A PM (with their PAs) can cover several sub-regions. They report to the default sub-region's PE, and can be assigned to clusters in any of them."/>

            <TextBlock Text="Default sub-region" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
            <ComboBox x:Name="CboDefault" DisplayMemberPath="Label" Style="{StaticResource FormComboBoxStyle}"
                      Margin="0,0,0,14" SelectionChanged="CboDefault_SelectionChanged"/>

            <TextBlock Text="Also covers" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Background="White" MaxHeight="260">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ListOthers" Margin="10,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          IsEnabled="{Binding IsEnabled}" FontSize="12" Margin="0,3"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Click="BtnCancel_Click" Margin="0,0,10,0"/>
                <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}" Click="BtnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
