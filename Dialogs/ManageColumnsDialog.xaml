<Window x:Class="PMDashboard.Dialogs.ManageColumnsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Columns"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Border Padding="28">
        <StackPanel>
            <TextBlock Text="Manage Columns" FontSize="18" FontWeight="SemiBold"
                       Foreground="#0F172A" Margin="0,0,0,4"/>
            <TextBlock FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,4">
                <Run Text="Editing columns for:"/>
                <Run Text="{Binding Mode, Mode=OneWay}" FontWeight="SemiBold"/>
            </TextBlock>
            <TextBlock Text="Column type can't be changed after it's created — delete and re-add if you need a different type."
                       FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,18"/>

            <!-- Existing columns -->
            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" MaxHeight="280" Margin="0,0,0,20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ColumnsList" ItemsSource="{Binding DynamicColumns}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0" Text="{Binding Name, Mode=OneWay}"
                                                 Tag="{Binding}" BorderThickness="0" Background="Transparent"
                                                 FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"
                                                 LostFocus="TxtColumnName_LostFocus"/>

                                        <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="4"
                                                Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ColumnType}" FontSize="10"
                                                       Foreground="#64748B" FontWeight="SemiBold"/>
                                        </Border>

                                        <Button Grid.Column="2" Content="▲" Tag="{Binding}"
                                                Style="{StaticResource IconButtonStyle}"
                                                Click="BtnMoveUp_Click" Margin="6,0,0,0"/>
                                        <Button Grid.Column="3" Content="▼" Tag="{Binding}"
                                                Style="{StaticResource IconButtonStyle}"
                                                Click="BtnMoveDown_Click"/>
                                        <Button Grid.Column="4" Content="Delete" Tag="{Binding}"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Padding="8,4" FontSize="11" Margin="6,0,0,0"
                                                Click="BtnDeleteColumn_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- No columns yet -->
            <TextBlock Text="No columns yet — add your first one below." FontSize="12"
                       Foreground="#94A3B8" Margin="0,-14,0,16" HorizontalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DynamicColumns.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Add column -->
            <TextBlock Text="Add Column" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="TxtNewColumnName"
                         Style="{StaticResource FormTextBoxStyle}"/>
                <ComboBox Grid.Column="2" x:Name="CboNewColumnType"
                          Style="{StaticResource FormComboBoxStyle}" SelectedIndex="0">
                    <ComboBoxItem Content="Text"/>
                    <ComboBoxItem Content="Number"/>
                    <ComboBoxItem Content="Date"/>
                    <ComboBoxItem Content="Bool"/>
                </ComboBox>
            </Grid>

            <TextBlock x:Name="TxtError" Foreground="#EF4444" FontSize="12"
                       Visibility="Collapsed" Margin="0,0,0,8" TextWrapping="Wrap"/>

            <Button Content="+ Add Column" Style="{StaticResource SecondaryButtonStyle}"
                    HorizontalAlignment="Left" Click="BtnAddColumn_Click" Margin="0,0,0,20"/>

            <Button Content="Close" Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Right" Click="BtnClose_Click"/>
        </StackPanel>
    </Border>
</Window>
