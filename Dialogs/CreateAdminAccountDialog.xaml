<Window x:Class="PMDashboard.Dialogs.CreateAdminAccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Admin Account — SAT"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Border Padding="28">
        <StackPanel>
            <TextBlock Text="Welcome to SAT" FontSize="20" FontWeight="Bold"
                       Foreground="#0F172A" Margin="0,0,0,4"/>
            <TextBlock Text="Site Assignment Tracker — no accounts exist yet. Create the first admin account to get started."
                       FontSize="13" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <!-- New computer joining an existing team: connect to the shared database instead of
                 creating a stray local admin (Dialogs/DatabaseConnectFlow). Hidden when this already
                 IS the shared database (a genuinely new team database needs its first admin). -->
            <Border x:Name="JoinTeamPanel" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                    CornerRadius="6" Padding="12,10" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Joining a team that already uses SAT?" FontSize="12" FontWeight="SemiBold"
                               Foreground="#1E3A8A"/>
                    <TextBlock Text="Connect to the shared network database instead — you'll sign in with your existing account there."
                               FontSize="11" Foreground="#1E40AF" TextWrapping="Wrap" Margin="0,2,0,8"/>
                    <Button Content="Connect to network database…" HorizontalAlignment="Left"
                            Style="{StaticResource SecondaryButtonStyle}" Click="BtnConnectDb_Click"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="First Name" FontSize="12" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtFirstName" Style="{StaticResource FormTextBoxStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Last Name" FontSize="12" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtLastName" Style="{StaticResource FormTextBoxStyle}"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Email" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtEmail" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,14"/>

            <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <PasswordBox x:Name="PwdNew" Style="{StaticResource FormPasswordBoxStyle}" Margin="0,0,0,14"/>

            <TextBlock Text="Confirm Password" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <PasswordBox x:Name="PwdConfirm" Style="{StaticResource FormPasswordBoxStyle}" Margin="0,0,0,8"/>

            <TextBlock x:Name="TxtError" Foreground="#EF4444" FontSize="12"
                       Visibility="Collapsed" Margin="0,0,0,12" TextWrapping="Wrap"/>

            <Button Content="Create Account" Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Right" Padding="16,9" Click="BtnCreate_Click"/>
        </StackPanel>
    </Border>
</Window>
