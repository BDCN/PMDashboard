<Window x:Class="PMDashboard.Dialogs.TeamMemberDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Team Member"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Border Padding="28">
        <StackPanel>
            <TextBlock x:Name="TxtTitle" Text="Add Team Member" FontSize="18"
                       FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,6"/>
            <TextBlock x:Name="TxtHint" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,18"/>

            <!-- Name / contact (Director, PE, PA) -->
            <StackPanel x:Name="PanelPerson">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="First Name" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtFirst" Style="{StaticResource FormTextBoxStyle}" TextChanged="Name_TextChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Last Name" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtLast" Style="{StaticResource FormTextBoxStyle}" TextChanged="Name_TextChanged"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Email" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtEmail" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,4" TextChanged="TxtEmail_TextChanged"/>
                <TextBlock x:Name="TxtEmailHint" Text="Filled in from the name (firstname.lastname@iemfg.com) — edit it if theirs is different."
                           FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <TextBlock Text="Phone" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtPhone" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,12"/>
            </StackPanel>

            <!-- Director: region (editable — a new region can be typed) -->
            <StackPanel x:Name="PanelRegion" Visibility="Collapsed">
                <TextBlock Text="Region they direct" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                <ComboBox x:Name="CboRegion" IsEditable="True" Style="{StaticResource FormComboBoxStyle}" Margin="0,0,0,12"/>
            </StackPanel>

            <!-- PE: sub-region -->
            <StackPanel x:Name="PanelSubRegion" Visibility="Collapsed">
                <TextBlock Text="Sub-region they control" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                <ComboBox x:Name="CboSubRegion" DisplayMemberPath="Label" Style="{StaticResource FormComboBoxStyle}" Margin="0,0,0,12"/>
            </StackPanel>

            <!-- PA: which PM -->
            <StackPanel x:Name="PanelPm" Visibility="Collapsed">
                <TextBlock Text="Supports PM" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                <ComboBox x:Name="CboPm" DisplayMemberPath="Label" Style="{StaticResource FormComboBoxStyle}" Margin="0,0,0,12"/>
            </StackPanel>

            <CheckBox x:Name="ChkActive" Content="Active" IsChecked="True" FontSize="12"
                      Foreground="#374151" Margin="0,4,0,8"/>

            <TextBlock x:Name="TxtError" Foreground="#EF4444" FontSize="12" TextWrapping="Wrap"
                       Visibility="Collapsed" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnCancel_Click" Margin="0,0,10,0"/>
                <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
