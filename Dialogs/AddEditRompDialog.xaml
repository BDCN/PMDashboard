<Window x:Class="PMDashboard.Dialogs.AddEditRompDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ROMP Details"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Border Padding="28">
        <StackPanel>

            <TextBlock x:Name="TxtTitle" Text="Add ROMP" FontSize="18"
                       FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,24"/>

            <!-- ROMP Name -->
            <TextBlock Text="ROMP Name" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtName" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,16"/>

            <!-- Parent Site -->
            <TextBlock Text="Parent Site" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <ComboBox x:Name="CboSite" Style="{StaticResource FormComboBoxStyle}"
                      DisplayMemberPath="Name"
                      Margin="0,0,0,8"/>

            <!-- Region hint -->
            <TextBlock x:Name="TxtRegionHint" Text="" FontSize="11"
                       Foreground="#64748B" Margin="0,0,0,16"/>

            <!-- Status (items loaded dynamically from StatusConfig in code-behind) -->
            <TextBlock Text="Status" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <ComboBox x:Name="CboStatus" Style="{StaticResource FormComboBoxStyle}"
                      Margin="0,0,0,12"/>

            <!-- Close shortcut — marks complete and hides from the list (edit only) -->
            <CheckBox x:Name="ChkMarkComplete" Content="Mark Complete &amp; Remove from List"
                      FontSize="12" FontWeight="SemiBold" Foreground="#B91C1C"
                      Margin="0,0,0,4"/>
            <TextBlock Text="Hides this ROMP from the list once saved — the data stays for reporting/scoring history. Use &quot;Show Completed&quot; on the ROMP list to find it again."
                       FontSize="11" Foreground="#94A3B8" Margin="0,0,0,20" TextWrapping="Wrap"/>

            <!-- Equipment Types (multi-select checkboxes, loaded from EquipmentCategories) -->
            <TextBlock Text="Equipment Types" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <TextBlock FontSize="11" Foreground="#64748B" Margin="0,0,0,8" TextWrapping="Wrap">
                <Run Text="Select all equipment types present on this ROMP. Each type's weight is summed for scoring."/>
            </TextBlock>

            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6"
                    Padding="12,8" Margin="0,0,0,20" Background="White">
                <ItemsControl x:Name="EquipmentList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding DisplayName}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Margin="0,4,0,4" FontSize="13"
                                      Foreground="#0F172A"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Error -->
            <TextBlock x:Name="TxtError" Foreground="#EF4444" FontSize="12"
                       Visibility="Collapsed" Margin="0,0,0,12" TextWrapping="Wrap"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnCancel_Click" Margin="0,0,10,0"/>
                <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}"
                        Click="BtnSave_Click"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
