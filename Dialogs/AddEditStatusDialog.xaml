<Window x:Class="PMDashboard.Dialogs.AddEditStatusDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Custom Status"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Border Padding="28">
        <StackPanel>
            <TextBlock Text="Add Custom Status" FontSize="18"
                       FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,24"/>

            <!-- Name -->
            <TextBlock Text="Status Name" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtName" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,20"/>

            <!-- Options -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                    CornerRadius="6" Padding="14,12" Margin="0,0,0,20">
                <StackPanel>
                    <CheckBox x:Name="ChkIsComplete" Content="Excluded from workload (Complete-type)"
                              FontSize="12" Foreground="#374151" Margin="0,0,0,6"
                              Checked="ChkIsComplete_Checked" Unchecked="ChkIsComplete_Unchecked"/>
                    <TextBlock Text="Sites and ROMPs with this status will not count toward a PM's workload."
                               FontSize="11" Foreground="#94A3B8" Margin="20,0,0,6" TextWrapping="Wrap"/>

                    <CheckBox x:Name="ChkCountsAsActive" Content="Counts as Active (turns site indicator yellow)"
                              FontSize="12" Foreground="#374151" Margin="0,8,0,6"/>
                    <TextBlock Text="A site with any ROMP in this status will show as Active (yellow)."
                               FontSize="11" Foreground="#94A3B8" Margin="20,0,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Error -->
            <TextBlock x:Name="TxtError" Foreground="#EF4444" FontSize="12"
                       Visibility="Collapsed" Margin="0,0,0,12" TextWrapping="Wrap"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnCancel_Click" Margin="0,0,10,0"/>
                <Button Content="Add" Style="{StaticResource PrimaryButtonStyle}"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
