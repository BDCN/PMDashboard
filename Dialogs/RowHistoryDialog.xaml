<Window x:Class="PMDashboard.Dialogs.RowHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Row History"
        Width="760" Height="480"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="TxtHeading" FontSize="17" FontWeight="SemiBold" Foreground="#0F172A"/>
            <TextBlock x:Name="TxtSubtitle" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1"
                Background="White" ClipToBounds="True">
            <DataGrid x:Name="HistoryGrid"
                      Style="{StaticResource AppDataGridStyle}"
                      CellStyle="{StaticResource DataGridCellStyle}"
                      ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                      AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="When (local)" Width="150"
                                        Binding="{Binding TimestampLocal, StringFormat='yyyy-MM-dd HH:mm:ss'}"/>
                    <DataGridTextColumn Header="User"    Width="200" Binding="{Binding UserDisplay}"/>
                    <DataGridTextColumn Header="Action"  Width="110" Binding="{Binding Action}"/>
                    <DataGridTextColumn Header="Details" Width="*"   Binding="{Binding Details}"/>
                    <DataGridTextColumn Header="Machine" Width="130" Binding="{Binding MachineName}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock x:Name="TxtEmpty" Grid.Row="1" Visibility="Collapsed"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap"
                   MaxWidth="460" TextAlignment="Center"/>

        <Button Grid.Row="2" Content="Close" HorizontalAlignment="Right" Margin="0,16,0,0"
                Style="{StaticResource PrimaryButtonStyle}" Click="BtnClose_Click"/>
    </Grid>
</Window>
