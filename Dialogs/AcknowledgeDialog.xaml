<Window x:Class="PMDashboard.Dialogs.AcknowledgeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Please Confirm"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Border Padding="28">
        <StackPanel>
            <DockPanel Margin="0,0,0,12">
                <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="18" Background="#FEF3C7" Margin="0,0,12,0"
                        VerticalAlignment="Top">
                    <TextBlock Text="⚠" FontSize="18" Foreground="#B45309" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TxtHeading" FontSize="17" FontWeight="SemiBold" Foreground="#0F172A"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>

            <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                <TextBlock x:Name="TxtMessage" FontSize="12.5" Foreground="#78350F" TextWrapping="Wrap"/>
            </Border>
            <TextBlock x:Name="TxtNote" FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,14"/>

            <CheckBox x:Name="ChkAck" FontSize="12.5" Foreground="#0F172A" Margin="0,0,0,8"
                      Checked="ChkAck_Changed" Unchecked="ChkAck_Changed">
                <TextBlock x:Name="TxtAck" TextWrapping="Wrap"/>
            </CheckBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Click="BtnCancel_Click"
                        Margin="0,0,10,0" IsCancel="True"/>
                <Button x:Name="BtnConfirm" Style="{StaticResource PrimaryButtonStyle}" Click="BtnConfirm_Click" IsEnabled="False"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
