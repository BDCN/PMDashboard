<Window x:Class="PMDashboard.Dialogs.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Password"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Border Padding="28">
        <StackPanel>
            <TextBlock x:Name="TxtHeading" Text="Change Password" FontSize="18" FontWeight="SemiBold"
                       Foreground="#0F172A" Margin="0,0,0,4"/>
            <TextBlock x:Name="TxtSubtitle" Text="Enter your current password and a new one."
                       FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,18"/>

            <TextBlock Text="Current Password" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <PasswordBox x:Name="PwdCurrent" Style="{StaticResource FormPasswordBoxStyle}" Margin="0,0,0,14"/>

            <TextBlock Text="New Password" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <PasswordBox x:Name="PwdNew" Style="{StaticResource FormPasswordBoxStyle}" Margin="0,0,0,14"/>

            <TextBlock Text="Confirm New Password" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <PasswordBox x:Name="PwdConfirm" Style="{StaticResource FormPasswordBoxStyle}" Margin="0,0,0,8"/>

            <TextBlock x:Name="TxtError" Foreground="#EF4444" FontSize="12"
                       Visibility="Collapsed" Margin="0,0,0,12" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnCancel_Click" Margin="0,0,10,0"/>
                <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
