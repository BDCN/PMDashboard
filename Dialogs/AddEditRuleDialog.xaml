<Window x:Class="PMDashboard.Dialogs.AddEditRuleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom Assignment Rule"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Border Padding="28">
        <StackPanel>
            <TextBlock Text="Add Custom Rule" FontSize="18" FontWeight="SemiBold"
                       Foreground="#0F172A" Margin="0,0,0,6"/>
            <TextBlock Text="Custom rules appear in the suggestion panel as reminders. They don't affect the automatic score calculation."
                       FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,24"/>

            <TextBlock Text="Rule Name" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtName" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,16"/>

            <TextBlock Text="Description" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtDescription" Style="{StaticResource FormTextBoxStyle}"
                     TextWrapping="Wrap" Height="72" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,16"/>

            <TextBlock Text="Weight" FontSize="12" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <TextBox x:Name="TxtWeight" Style="{StaticResource FormTextBoxStyle}"
                         Width="80" Text="1"/>
                <TextBlock Text="Higher weight = more influence on the score ranking"
                           FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>

            <TextBlock x:Name="TxtError" Foreground="#EF4444" FontSize="12"
                       Visibility="Collapsed" Margin="0,0,0,12" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnCancel_Click" Margin="0,0,10,0"/>
                <Button Content="Add Rule" Style="{StaticResource PrimaryButtonStyle}"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
