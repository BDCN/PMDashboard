<UserControl x:Class="PMDashboard.Views.OrgChartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">

    <UserControl.Resources>
        <SolidColorBrush x:Key="LineBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="MatchBrush" Color="#F59E0B"/>
        <!-- PMs (and their PAs) on more than one sub-region -->
        <LinearGradientBrush x:Key="MultiSubBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F0FDF4" Offset="0"/>
            <GradientStop Color="#BBF7D0" Offset="1"/>
        </LinearGradientBrush>
        <!-- TBD placeholders (to be hired) -->
        <LinearGradientBrush x:Key="TbdBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFBEB" Offset="0"/>
            <GradientStop Color="#FEF3C7" Offset="1"/>
        </LinearGradientBrush>

        <!-- Connector pieces -->
        <Style x:Key="VLine" TargetType="Border">
            <Setter Property="Width" Value="2"/>
            <Setter Property="Background" Value="{StaticResource LineBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="HLine" TargetType="Border">
            <Setter Property="Height" Value="2"/>
            <Setter Property="Background" Value="{StaticResource LineBrush}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <!-- Name lines inside cards -->
        <Style x:Key="CardRole" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,28,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Title ── -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="✎ Edit Org Chart" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Click="BtnBeginEdit_Click"
                        Visibility="{Binding ShowEditButton, Converter={StaticResource BoolToVisibility}}"
                        ToolTipService.ToolTip="Drag PMs between sub-regions and PAs between PMs, then Save"/>
                <Button Content="Edit Teams" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="BtnEditTeams_Click"/>
                <Button Content="Export PNG" Style="{StaticResource PrimaryButtonStyle}" Click="BtnExport_Click"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Org Chart" FontSize="22" FontWeight="Bold" Foreground="#0F172A" FontFamily="Segoe UI Semibold"/>
                <TextBlock Text="{Binding Headline}" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- ── Toolbar, edit banner, status ── -->
        <StackPanel Grid.Row="1">
        <Border Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1"
                Padding="12,6" Margin="0,0,0,12">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="🔍" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="200"
                         BorderThickness="0" Background="Transparent" FontSize="12" VerticalAlignment="Center"
                         ToolTipService.ToolTip="Find a person — matching cards are outlined"/>
                <TextBlock Text="{Binding MatchInfo}" FontSize="11" Foreground="#B45309" VerticalAlignment="Center" Margin="6,0,0,0"/>
                <Border Width="1" Background="#E2E8F0" Margin="14,4"/>
                <CheckBox Content="Clusters" IsChecked="{Binding ShowClusters, Mode=TwoWay}" FontSize="12"
                          Foreground="#374151" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <CheckBox Content="PAs" IsChecked="{Binding ShowPas, Mode=TwoWay}" FontSize="12"
                          Foreground="#374151" VerticalAlignment="Center"/>
                <Border Width="1" Background="#E2E8F0" Margin="14,4"/>
                <TextBlock Text="Zoom" FontSize="12" Foreground="#374151" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Slider Minimum="0.3" Maximum="1.5" Value="{Binding Zoom, Mode=TwoWay}" Width="140"
                        VerticalAlignment="Center" SmallChange="0.05" LargeChange="0.1"/>
                <TextBlock Text="{Binding ZoomText}" FontSize="12" Foreground="#64748B" Width="40" VerticalAlignment="Center" Margin="6,0,0,0"/>
                <Button Content="Fit" Style="{StaticResource SecondaryButtonStyle}" Padding="10,3" FontSize="11"
                        Click="BtnFit_Click" ToolTipService.ToolTip="Zoom so the whole chart fits the width"/>
                <TextBlock Text="Ctrl + mouse wheel zooms · click a PM to open their details" FontSize="11"
                           Foreground="#94A3B8" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </WrapPanel>
        </Border>

        <!-- Edit mode banner -->
        <Border Background="#EEF2FF" BorderBrush="#A5B4FC" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="BtnCancelEdit_Click"/>
                    <Button Content="Save Changes" Style="{StaticResource PrimaryButtonStyle}" Click="BtnSaveEdit_Click"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="12" Foreground="#312E81" TextWrapping="Wrap">
                        <Run Text="Editing." FontWeight="SemiBold"/>
                        <Run Text="Drag a PM onto another sub-region to move them there (it becomes their default; other sub-regions are kept). Hold Ctrl while dropping to add a sub-region instead. Drop on “No team yet” to take them off every team. Drag a PA onto another PM. Dragging near the edge scrolls the chart — or use “Move to…” on a card to pick from a list. ★ makes a sub-region the default, ✕ removes it."/>
                    </TextBlock>
                    <TextBlock Text="{Binding ChangeSummary}" FontSize="12" FontWeight="SemiBold" Foreground="#7C3AED" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#16A34A" TextWrapping="Wrap" Margin="0,-4,0,10">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusMessage}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        </StackPanel>

        <!-- ── Chart ── -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
            <!-- In edit mode the whole chart is a drop area: near an edge it auto-scrolls, and a drop
                 anywhere lands in the column under the pointer (see ChartScroll_* in code-behind). -->
            <ScrollViewer x:Name="ChartScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="ChartScroll_PreviewMouseWheel"
                          AllowDrop="{Binding IsEditMode}"
                          PreviewDragOver="ChartScroll_PreviewDragOver" DragOver="ChartScroll_DragOver"
                          DragLeave="ChartScroll_DragLeave" Drop="ChartScroll_Drop">
                <Border x:Name="ChartRoot" Background="White" Padding="28,24" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Border.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/>
                    </Border.LayoutTransform>
                    <StackPanel>
                        <TextBlock Text="No teams yet — set up Directors, sub-regions, PEs and PMs on the Teams page."
                                   FontSize="14" Foreground="#94A3B8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Regions.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- One tree per region, side by side -->
                        <ItemsControl ItemsSource="{Binding Regions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12"
                                            Padding="18,16,18,20" Margin="0,0,28,0" VerticalAlignment="Top">
                                        <StackPanel>
                                            <!-- Region title -->
                                            <TextBlock HorizontalAlignment="Center" Margin="0,0,0,2">
                                                <Run Text="{Binding Region, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#64748B"
                                                       HorizontalAlignment="Center" Margin="0,0,0,12"/>

                                            <!-- Director card -->
                                            <Border HorizontalAlignment="Center" MinWidth="220" MaxWidth="420" CornerRadius="8"
                                                    Padding="14,10" BorderThickness="2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#0F172A"/>
                                                        <Setter Property="BorderBrush" Value="#0F172A"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasDirector}" Value="False">
                                                                <Setter Property="Background" Value="#F1F5F9"/>
                                                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DirectorMatch}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{StaticResource MatchBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="DIRECTOR" Style="{StaticResource CardRole}" Foreground="#94A3B8"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DirectorText}" FontSize="15" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="White"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasDirector}" Value="False">
                                                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>

                                            <!-- Trunk down to the sub-region row -->
                                            <Border Style="{StaticResource VLine}" Height="18"/>

                                            <!-- Sub-region columns -->
                                            <ItemsControl ItemsSource="{Binding Columns}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Tag="{Binding}" Background="Transparent" CornerRadius="8"
                                                                AllowDrop="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                DragOver="Column_DragOver" DragLeave="Column_DragLeave" Drop="Column_Drop">
                                                        <StackPanel MinWidth="250" Margin="0,0,0,8">
                                                            <!-- Horizontal bus: left half hidden on the first column, right half on the last -->
                                                            <Grid Height="18">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Margin="0,0,-1,0">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border" BasedOn="{StaticResource HLine}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                </Border>
                                                                <Border Grid.Column="1" Margin="-1,0,0,0">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border" BasedOn="{StaticResource HLine}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                </Border>
                                                                <Border Grid.ColumnSpan="2" Style="{StaticResource VLine}"/>
                                                            </Grid>

                                                            <!-- PE / sub-region card -->
                                                            <Border Margin="10,0" CornerRadius="8" Padding="12,9" BorderThickness="2">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#2563EB"/>
                                                                        <Setter Property="BorderBrush" Value="#2563EB"/>
                                                                        <Style.Triggers>
                                                                            <!-- sub-region without a PE yet: greyed -->
                                                                            <DataTrigger Binding="{Binding HasPe}" Value="False">
                                                                                <Setter Property="Background" Value="#94A3B8"/>
                                                                                <Setter Property="BorderBrush" Value="#94A3B8"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsNoTeam}" Value="True">
                                                                                <Setter Property="Background" Value="#FFFBEB"/>
                                                                                <Setter Property="BorderBrush" Value="#FCD34D"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding PeMatch}" Value="True">
                                                                                <Setter Property="BorderBrush" Value="{StaticResource MatchBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Grid>
                                                                <StackPanel Margin="0,0,78,0">
                                                                        <DockPanel>
                                                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Foreground" Value="White"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsNoTeam}" Value="True">
                                                                                                <Setter Property="Foreground" Value="#92400E"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </DockPanel>
                                                                        <!-- PE line (not on the No-team column) -->
                                                                        <TextBlock TextWrapping="Wrap" Margin="0,3,0,0">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsNoTeam}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                            <Run Text="PE  " FontSize="10" FontWeight="SemiBold" Foreground="#BFDBFE"/>
                                                                            <Run Text="{Binding PeText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                                                        </TextBlock>
                                                                        <TextBlock Text="PMs not on any sub-region — they can only take clusters with no sub-region"
                                                                                   FontSize="10" Foreground="#B45309" TextWrapping="Wrap" Margin="0,3,0,0">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsNoTeam}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <TextBlock Text="{Binding Clusters}" FontSize="10" Foreground="#DBEAFE"
                                                                                   TextWrapping="Wrap" Margin="0,4,0,0">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasClusters}" Value="False">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <StackPanel Margin="0,6,0,0" Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                                                                            <Button Content="+ TBD PM" Tag="{Binding}" Click="BtnAddTbdPm_Click" HorizontalAlignment="Left"
                                                                                    Style="{StaticResource SecondaryButtonStyle}" Padding="6,1" FontSize="10"
                                                                                    ToolTipService.ToolTip="Add a placeholder PM (to be hired) to this sub-region — work can be assigned to it now"
                                                                                    Visibility="{Binding CanAddTbd, Converter={StaticResource BoolToVisibility}}"/>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                    <!-- PMs, then TBD PMs, then PAs (· TBD PAs) -->
                                                                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                                                                                <StackPanel.Resources>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="FontSize" Value="10"/>
                                                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                                                        <Setter Property="Foreground" Value="#BFDBFE"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsNoTeam}" Value="True">
                                                                                                <Setter Property="Foreground" Value="#B45309"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </StackPanel.Resources>
                                                                                <TextBlock Text="{Binding PmCountText}"/>
                                                                                <TextBlock Text="{Binding TbdPmText}"/>
                                                                                <TextBlock Text="{Binding PaCountText}"/>
                                                                            </StackPanel>
                                                                </Grid>
                                                            </Border>

                                                            <!-- PMs: bracket line down the left, one stub per card -->
                                                            <ItemsControl ItemsSource="{Binding Pms}" Margin="10,0,10,0">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <!-- One row per PM: PM card (left) ─ trunk from the PE ─ PA card(s) (right), the PA
                                                                             directly across from the PM they support. The whole row accepts a PA drop. -->
                                                                        <Grid Tag="{Binding}" Background="Transparent"
                                                                              AllowDrop="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                              DragOver="PmCard_DragOver" Drop="PmCard_Drop">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="220"/>   <!-- PM card -->
                                                                                <ColumnDefinition Width="18"/>    <!-- stub to the trunk -->
                                                                                <ColumnDefinition Width="2"/>     <!-- trunk -->
                                                                                <ColumnDefinition Width="Auto"/>  <!-- stub + PA card(s) -->
                                                                            </Grid.ColumnDefinitions>
                                                                            <!-- trunk: full height, or down to the stubs on the last row -->
                                                                            <Border Grid.Column="2" Width="2" HorizontalAlignment="Left" Background="{StaticResource LineBrush}">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                                                                <Setter Property="VerticalAlignment" Value="Top"/>
                                                                                                <Setter Property="Height" Value="31"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                            </Border>
                                                                            <Border Grid.Column="1" Style="{StaticResource HLine}" Margin="0,29,0,0"/>

                                                                            <!-- PM card (click → PM Detail; drag in edit mode) -->
                                                                            <Border Grid.Column="0" Margin="0,10,0,0" CornerRadius="6" Padding="10,7"
                                                                                    BorderThickness="1,1,1,1" Cursor="Hand"
                                                                                    Tag="{Binding}" MouseLeftButtonUp="PmCard_Click"
                                                                                    PreviewMouseLeftButtonDown="PmCard_MouseDown" MouseMove="PmCard_MouseMove">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                                                                        <Setter Property="Background" Value="White"/>
                                                                                        <Setter Property="ToolTip" Value="Open PM details"/>
                                                                                        <Style.Triggers>
                                                                                            <!-- also on this sub-region, but their default is another -->
                                                                                            <!-- on several sub-regions: green so they stand out in every column -->
                                                                                            <DataTrigger Binding="{Binding HasSeveralSubRegions}" Value="True">
                                                                                                <Setter Property="Background" Value="{StaticResource MultiSubBrush}"/>
                                                                                                <Setter Property="BorderBrush" Value="#4ADE80"/>
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                                                                <Setter Property="Background" Value="{StaticResource TbdBrush}"/>
                                                                                                <Setter Property="BorderBrush" Value="#F59E0B"/>
                                                                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                                                <Setter Property="Cursor" Value="SizeAll"/>
                                                                                                <Setter Property="ToolTip" Value="Drag to another sub-region (Ctrl = add)"/>
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                                                                                <Setter Property="BorderBrush" Value="#7C3AED"/>
                                                                                                <Setter Property="BorderThickness" Value="2"/>
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding IsMatch}" Value="True">
                                                                                                <Setter Property="BorderBrush" Value="{StaticResource MatchBrush}"/>
                                                                                                <Setter Property="BorderThickness" Value="2"/>
                                                                                                <Setter Property="Background" Value="#FFFBEB"/>
                                                                                            </DataTrigger>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter Property="BorderBrush" Value="#2563EB"/>
                                                                                            </Trigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <StackPanel>
                                                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                                                                                    <TextBlock FontSize="10.5" Foreground="#64748B">
                                                                                        <Run Text="PM · " FontWeight="SemiBold"/><Run Text="{Binding Detail, Mode=OneWay}"/>
                                                                                    </TextBlock>
                                                                                    <TextBlock Text="{Binding TagText}" FontSize="10.5" Foreground="#2563EB" TextWrapping="Wrap"
                                                                                               Visibility="{Binding HasTag, Converter={StaticResource BoolToVisibility}}"/>
                                                                                    <TextBlock Text="TBD — PM to be hired. Work can be assigned now; Fill… when hired."
                                                                                               FontSize="10.5" Foreground="#B45309" TextWrapping="Wrap" FontStyle="Italic"
                                                                                               Visibility="{Binding IsPlaceholder, Converter={StaticResource BoolToVisibility}}"/>
                                                                                    <!-- Campuses this PM currently covers -->
                                                                                    <TextBlock FontSize="10.5" Foreground="#334155" TextWrapping="Wrap" Margin="0,3,0,0"
                                                                                               ToolTip="{Binding CampusTip}"
                                                                                               Visibility="{Binding HasCampuses, Converter={StaticResource BoolToVisibility}}">
                                                                                        <Run Text="{Binding CampusHeader, Mode=OneWay}" FontWeight="SemiBold" Foreground="#64748B"/><Run Text="{Binding CampusText, Mode=OneWay}"/>
                                                                                    </TextBlock>
                                                                                    <!-- Edit-mode actions -->
                                                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                                                                                        <Button Content="Fill…" Tag="{Binding}" Click="BtnFillPm_Click"
                                                                                                Style="{StaticResource PrimaryButtonStyle}" Padding="6,1" FontSize="10" Margin="0,0,4,0"
                                                                                                ToolTipService.ToolTip="Someone was hired — turn this TBD into them (keeps all its work)"
                                                                                                Visibility="{Binding IsPlaceholder, Converter={StaticResource BoolToVisibility}}"/>
                                                                                        <Button Content="+ TBD PA" Tag="{Binding}" Click="BtnAddTbdPa_Click"
                                                                                                Style="{StaticResource SecondaryButtonStyle}" Padding="6,1" FontSize="10" Margin="0,0,4,0"
                                                                                                ToolTipService.ToolTip="Add a placeholder PA (to be hired) supporting this PM"/>
                                                                                        <Button Content="Move to…" Tag="{Binding}" Click="BtnMoveTo_Click"
                                                                                                Style="{StaticResource SecondaryButtonStyle}" Padding="6,1" FontSize="10" Margin="0,0,4,0"
                                                                                                ToolTipService.ToolTip="Pick a sub-region from a list instead of dragging"/>
                                                                                        <Button Content="★ Make default" Tag="{Binding}" Click="BtnMakeDefault_Click"
                                                                                                Style="{StaticResource SecondaryButtonStyle}" Padding="6,1" FontSize="10" Margin="0,0,4,0"
                                                                                                Visibility="{Binding IsSecondary, Converter={StaticResource BoolToVisibility}}"/>
                                                                                        <Button Content="✕ Remove" Tag="{Binding}" Click="BtnRemoveSub_Click"
                                                                                                Style="{StaticResource DangerButtonStyle}" Padding="6,1" FontSize="10"
                                                                                                ToolTipService.ToolTip="Take this PM off this sub-region"
                                                                                                Visibility="{Binding InSubRegion, Converter={StaticResource BoolToVisibility}}"/>
                                                                                        <Button Content="Remove TBD" Tag="{Binding}" Click="BtnRemoveTbd_Click"
                                                                                                Style="{StaticResource DangerButtonStyle}" Padding="6,1" FontSize="10" Margin="4,0,0,0"
                                                                                                Visibility="{Binding IsPlaceholder, Converter={StaticResource BoolToVisibility}}"/>
                                                                                    </StackPanel>
                                                                                </StackPanel>
                                                                            </Border>

                                                                            <!-- PA card(s), directly across from their PM -->
                                                                            <Grid Grid.Column="3" Visibility="{Binding HasPas, Converter={StaticResource BoolToVisibility}}">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="18"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <Border Style="{StaticResource HLine}" Margin="0,29,0,0"/>
                                                                                <!-- several PAs: a short vertical joins them -->
                                                                                <Border Width="2" HorizontalAlignment="Right" Margin="0,29,0,31" Background="{StaticResource LineBrush}"
                                                                                        Visibility="{Binding HasSeveralPas, Converter={StaticResource BoolToVisibility}}"/>
                                                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Pas}">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <Border Tag="{Binding}" Width="170" Margin="0,10,0,0" CornerRadius="6" Padding="10,7"
                                                                                                    PreviewMouseLeftButtonDown="PmCard_MouseDown" MouseMove="PmCard_MouseMove">
                                                                                                <Border.Style>
                                                                                                    <Style TargetType="Border">
                                                                                                        <Setter Property="Background" Value="#F5F3FF"/>
                                                                                                        <Setter Property="BorderBrush" Value="#C4B5FD"/>
                                                                                                        <Setter Property="BorderThickness" Value="1"/>
                                                                                                        <Style.Triggers>
                                                                                                            <DataTrigger Binding="{Binding IsTeamOnSeveral}" Value="True">
                                                                                                                <Setter Property="Background" Value="{StaticResource MultiSubBrush}"/>
                                                                                                                <Setter Property="BorderBrush" Value="#4ADE80"/>
                                                                                                            </DataTrigger>
                                                                                                            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                                                                                <Setter Property="Background" Value="{StaticResource TbdBrush}"/>
                                                                                                                <Setter Property="BorderBrush" Value="#F59E0B"/>
                                                                                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                                                                            </DataTrigger>
                                                                                                            <DataTrigger Binding="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                                                                <Setter Property="Cursor" Value="SizeAll"/>
                                                                                                                <Setter Property="ToolTip" Value="Drag onto another PM"/>
                                                                                                            </DataTrigger>
                                                                                                            <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                                                                                                <Setter Property="BorderBrush" Value="#7C3AED"/>
                                                                                                                <Setter Property="BorderThickness" Value="2"/>
                                                                                                            </DataTrigger>
                                                                                                            <DataTrigger Binding="{Binding IsMatch}" Value="True">
                                                                                                                <Setter Property="BorderBrush" Value="{StaticResource MatchBrush}"/>
                                                                                                                <Setter Property="BorderThickness" Value="2"/>
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </Border.Style>
                                                                                                <StackPanel>
                                                                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#4C1D95"/>
                                                                                                    <TextBlock FontSize="10.5" Foreground="#7C3AED" TextWrapping="Wrap">
                                                                                                        <Run Text="PA" FontWeight="SemiBold"/><Run Text="{Binding SupportsText, Mode=OneWay}"/>
                                                                                                    </TextBlock>
                                                                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                                                                                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsPlaceholder, Converter={StaticResource BoolToVisibility}}">
                                                                                                            <Button Content="Fill…" Tag="{Binding}" Click="BtnFillPa_Click"
                                                                                                                    Style="{StaticResource PrimaryButtonStyle}" Padding="6,1" FontSize="10" Margin="0,0,4,0"
                                                                                                                    ToolTipService.ToolTip="The PA was hired — enter their details"/>
                                                                                                            <Button Content="Remove" Tag="{Binding}" Click="BtnRemoveTbd_Click"
                                                                                                                    Style="{StaticResource DangerButtonStyle}" Padding="6,1" FontSize="10"/>
                                                                                                        </StackPanel>
                                                                                                    </StackPanel>
                                                                                                </StackPanel>
                                                                                            </Border>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </Grid>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock Text="No PMs yet" FontSize="11" FontStyle="Italic" Foreground="#94A3B8"
                                                                       Margin="22,10,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasPms}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- People who don't fit the tree yet -->
                        <ItemsControl ItemsSource="{Binding Notes}" Margin="0,16,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="#B45309" Margin="0,0,0,4"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
