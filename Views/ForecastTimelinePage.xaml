<UserControl x:Class="PMDashboard.Views.ForecastTimelinePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">

    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Title + stats -->
            <RowDefinition Height="Auto"/>  <!-- Filters -->
            <RowDefinition Height="*"/>     <!-- Chart body -->
            <RowDefinition Height="Auto"/>  <!-- Bottom axis -->
        </Grid.RowDefinitions>

        <!-- ── Title + Stats ── -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
            <TextBlock Text="Forecast Timeline"
                       FontSize="22" FontWeight="Bold"
                       Foreground="#0F172A" FontFamily="Segoe UI Semibold"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="{Binding BarCount, StringFormat={}{0} bars}"
                           FontSize="13" Foreground="#2563EB"/>
                <TextBlock Text="  •  " FontSize="13" Foreground="#64748B"/>
                <TextBlock Text="{Binding ClusterCount, StringFormat={}{0} clusters}"
                           FontSize="13" Foreground="#64748B"/>
                <TextBlock Text="  •  " FontSize="13" Foreground="#64748B"/>
                <TextBlock Text="{Binding DateRangeText}"
                           FontSize="13" Foreground="#64748B"/>

                <!-- New-campus bars: informational, not a warning — these ARE shown on the
                     chart (amber), just flagged since there's no matching Site record yet. -->
                <TextBlock Text="  •  " FontSize="13" Foreground="#64748B">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NewCampusBarCount}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding NewCampusBarCount, StringFormat={}{0} not yet in system}"
                           FontSize="13" Foreground="#CA8A04">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NewCampusBarCount}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Excluded rows: a genuine data-quality drop (no NBD/PFHO at all, or
                     unparseable) — these never produce a bar, unlike new-campus rows above. -->
                <TextBlock Text="  •  " FontSize="13" Foreground="#64748B">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ExcludedCount}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding ExcludedCount, StringFormat={}{0} row(s) excluded (no dates)}"
                           FontSize="13" Foreground="#94A3B8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ExcludedCount}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Schedule conflicts: a PM with too many same-region CX-window overlaps —
                     see ForecastTimelineViewModel.ComputeConflicts. -->
                <TextBlock Text="  •  " FontSize="13" Foreground="#64748B">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ConflictBarCount}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding ConflictBarCount, StringFormat={}⚠ {0} schedule conflict(s)}"
                           FontSize="13" FontWeight="SemiBold" Foreground="#991B1B">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ConflictBarCount}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </StackPanel>

            <!-- Visible only when there's something to add -->
            <Button Grid.Column="1" x:Name="BtnAddCampuses" Content="Add New Sites…"
                    Padding="14,8" VerticalAlignment="Center" Click="BtnAddCampuses_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NewCampusBarCount}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- ── Filters ── -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Cluster:" FontSize="12" Foreground="#64748B"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox ItemsSource="{Binding ClusterOptions}" SelectedItem="{Binding SelectedCluster}"
                          FontSize="12" MinWidth="110" VerticalContentAlignment="Center" Margin="0,0,20,0"/>

                <TextBlock Text="Region:" FontSize="12" Foreground="#64748B"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox ItemsSource="{Binding RegionOptions}" SelectedItem="{Binding SelectedRegion}"
                          FontSize="12" MinWidth="100" VerticalContentAlignment="Center" Margin="0,0,20,0"/>

                <TextBlock Text="Assignment:" FontSize="12" Foreground="#64748B"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox ItemsSource="{Binding AssignmentOptions}" SelectedItem="{Binding SelectedAssignment}"
                          FontSize="12" MinWidth="110" VerticalContentAlignment="Center" Margin="0,0,20,0"/>

                <TextBlock Text="From:" FontSize="12" Foreground="#64748B"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker SelectedDate="{Binding StartDateFilter}" FontSize="12"
                            Width="120" VerticalContentAlignment="Center" Margin="0,0,16,0"/>

                <TextBlock Text="To:" FontSize="12" Foreground="#64748B"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker SelectedDate="{Binding EndDateFilter}" FontSize="12"
                            Width="120" VerticalContentAlignment="Center" Margin="0,0,20,0"/>

                <CheckBox Content="Show Past" IsChecked="{Binding ShowPast}"
                          FontSize="12" Foreground="#374151" VerticalAlignment="Center" Margin="0,0,20,0"/>

                <!-- Compare PM — restricts bars to campuses currently assigned to the selected
                     PM(s); there's no PM-side date to plot, so this is a filter, not a 2nd bar. -->
                <TextBlock Text="Compare PM:" FontSize="12" Foreground="#64748B"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button x:Name="BtnPmFilter" Content="{Binding PmFilterLabel}"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="12"
                        Margin="0,0,20,0" Click="BtnPmFilter_Click"/>

                <TextBlock Text="Sites:" FontSize="12" Foreground="#64748B"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button x:Name="BtnCampusFilter" Content="{Binding CampusFilterLabel}"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="12"
                        Margin="0,0,20,0" Click="BtnCampusFilter_Click"/>

                <Button Content="Clear Filters" Style="{StaticResource SecondaryButtonStyle}"
                        Padding="10,5" FontSize="11" Margin="0,0,20,0" Click="BtnClearFilters_Click"/>

                <!-- Sort — click once for earliest first, again for latest first; ✕ = original
                     cluster order. The button label shows the active sort and direction. -->
                <TextBlock Text="Sort:" FontSize="12" Foreground="#64748B"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button Content="{Binding NbdSortLabel}" Style="{StaticResource SecondaryButtonStyle}"
                        Padding="10,5" FontSize="12" Margin="0,0,6,0" Click="BtnSortNbd_Click"
                        ToolTip="Sort bars by NBD (need-by date). Click again to reverse."/>
                <Button Content="{Binding PfhoSortLabel}" Style="{StaticResource SecondaryButtonStyle}"
                        Padding="10,5" FontSize="12" Margin="0,0,6,0" Click="BtnSortPfho_Click"
                        ToolTip="Sort bars by PFHO (handover date). Click again to reverse."/>
                <Button Content="✕" Style="{StaticResource SecondaryButtonStyle}" Padding="8,5" FontSize="11"
                        Click="BtnSortClear_Click" ToolTip="Back to the original cluster order">
                    <Button.Visibility>
                        <Binding Path="IsSorted" Mode="OneWay">
                            <Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter>
                        </Binding>
                    </Button.Visibility>
                </Button>
            </WrapPanel>
        </Border>

        <!-- PM compare popup -->
        <Popup x:Name="PmFilterPopup" PlacementTarget="{Binding ElementName=BtnPmFilter}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6"
                    Padding="12" Width="240">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" Opacity="0.15" BlurRadius="12" ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="All" Padding="8,3" FontSize="11" Margin="0,0,6,0"
                                Click="PmSelectAll_Click"/>
                        <Button Content="None" Padding="8,3" FontSize="11" Click="PmSelectNone_Click"/>
                    </StackPanel>
                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PmCheckList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}"
                                              FontSize="12" Margin="0,3"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Content="Apply" Style="{StaticResource PrimaryButtonStyle}"
                            Padding="10,6" Margin="0,8,0,0" Click="PmFilterApply_Click"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Campus scope popup -->
        <Popup x:Name="CampusFilterPopup" PlacementTarget="{Binding ElementName=BtnCampusFilter}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6"
                    Padding="12" Width="240">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" Opacity="0.15" BlurRadius="12" ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="All" Padding="8,3" FontSize="11" Margin="0,0,6,0"
                                Click="CampusSelectAll_Click"/>
                        <Button Content="None" Padding="8,3" FontSize="11" Click="CampusSelectNone_Click"/>
                    </StackPanel>
                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="CampusCheckList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"
                                              FontSize="12" Margin="0,3"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Content="Apply" Style="{StaticResource PrimaryButtonStyle}"
                            Padding="10,6" Margin="0,8,0,0" Click="CampusFilterApply_Click"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ── Chart body ── -->
        <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="1,1,1,0"
                CornerRadius="10,10,0,0" Background="White" Padding="0,10,20,10">
            <Grid>
                <!-- Empty state — no NBD/PFHO-matched rows at all -->
                <TextBlock Text="No forecast rows have both NBD and PFHO dates matched to a site yet."
                           FontSize="13" Foreground="#94A3B8" FontStyle="Italic"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasData}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="ChartGrid" ClipToBounds="True" SizeChanged="ChartGrid_SizeChanged">

                        <!-- Background: faint month gridlines -->
                        <Canvas x:Name="BackgroundCanvas"
                                IsHitTestVisible="False"
                                Margin="260,0,0,0"
                                VerticalAlignment="Stretch"
                                HorizontalAlignment="Left"/>

                        <!-- Bar rows -->
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="38">
                                        <Grid.ToolTip>
                                            <ToolTip>
                                                <TextBlock Text="{Binding TooltipText}"
                                                           FontFamily="Segoe UI" FontSize="12"
                                                           LineHeight="18"/>
                                            </ToolTip>
                                        </Grid.ToolTip>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Row separator -->
                                        <Border Grid.ColumnSpan="2" BorderBrush="#F1F5F9"
                                                BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>

                                        <!-- Campus / Cluster · Room Type label -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                                    HorizontalAlignment="Right" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding CampusName}" FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="248">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#0F172A"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUnmatched}" Value="True">
                                                                <Setter Property="Foreground" Value="#B45309"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding SubLabel}" FontSize="10"
                                                       Foreground="#64748B" HorizontalAlignment="Right"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="248"/>
                                        </StackPanel>

                                        <!-- Bar positioned by date along the shared axis — colored by
                                             progress against today (blue = not started, red = in
                                             progress, grey = completed); once the campus has a PM
                                             assigned, each status color gradients into green (a
                                             quick "is this covered?" signal layered on top of
                                             progress); an amber outline instead for a campus with
                                             no matching Site record yet takes visual priority over
                                             both of those. -->
                                        <Canvas Grid.Column="1" VerticalAlignment="Center" Height="22">
                                            <Rectangle Canvas.Left="{Binding BarX}" Width="{Binding BarWidth}"
                                                       Height="22" RadiusX="4" RadiusY="4"
                                                       SnapsToDevicePixels="True">
                                                <Rectangle.Style>
                                                    <Style TargetType="Rectangle">
                                                        <Setter Property="Fill" Value="#2563EB"/>
                                                        <Setter Property="Stroke" Value="{x:Null}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding BarStatus}" Value="InProgress">
                                                                <Setter Property="Fill" Value="#DC2626"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding BarStatus}" Value="Completed">
                                                                <Setter Property="Fill" Value="#94A3B8"/>
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding BarStatus}" Value="NotStarted"/>
                                                                    <Condition Binding="{Binding IsAssigned}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Fill">
                                                                    <Setter.Value>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                            <GradientStop Color="#2563EB" Offset="0"/>
                                                                            <GradientStop Color="#16A34A" Offset="1"/>
                                                                        </LinearGradientBrush>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </MultiDataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding BarStatus}" Value="InProgress"/>
                                                                    <Condition Binding="{Binding IsAssigned}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Fill">
                                                                    <Setter.Value>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                            <GradientStop Color="#DC2626" Offset="0"/>
                                                                            <GradientStop Color="#16A34A" Offset="1"/>
                                                                        </LinearGradientBrush>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </MultiDataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding BarStatus}" Value="Completed"/>
                                                                    <Condition Binding="{Binding IsAssigned}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Fill">
                                                                    <Setter.Value>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                            <GradientStop Color="#94A3B8" Offset="0"/>
                                                                            <GradientStop Color="#16A34A" Offset="1"/>
                                                                        </LinearGradientBrush>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </MultiDataTrigger>
                                                            <!-- Schedule conflict — dark red outline, drawn after
                                                                 the fill triggers above so it layers on top of any
                                                                 of them (blue/red/grey, assigned or not). -->
                                                            <DataTrigger Binding="{Binding HasConflict}" Value="True">
                                                                <Setter Property="Stroke" Value="#991B1B"/>
                                                                <Setter Property="StrokeThickness" Value="2"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsUnmatched}" Value="True">
                                                                <Setter Property="Fill" Value="#FEF3C7"/>
                                                                <Setter Property="Stroke" Value="#D97706"/>
                                                                <Setter Property="StrokeThickness" Value="1.5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Rectangle.Style>
                                            </Rectangle>
                                            <!-- Small warning badge for a schedule conflict — easier
                                                 to spot at a glance than a 2px outline alone,
                                                 especially on a narrow bar. -->
                                            <TextBlock Text="⚠" Canvas.Left="{Binding BarX}" FontSize="13"
                                                       Foreground="#991B1B" FontWeight="Bold"
                                                       Margin="-16,-2,0,0" IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasConflict}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Canvas>

                                        <!-- Suggest PM — only for a matched campus with no PM yet;
                                             floats at the right edge of the bar column regardless
                                             of where the bar itself is drawn (no horizontal scroll
                                             on this chart, so a fixed-position overlay is safe). -->
                                        <Button Grid.Column="1" Content="Suggest PM…" Tag="{Binding}"
                                                Click="BtnSuggestPm_Click"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Padding="8,4" FontSize="11" Margin="0,0,4,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsAssigned}" Value="False"/>
                                                                <Condition Binding="{Binding IsUnmatched}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ── Bottom axis — month ticks ── -->
        <Border Grid.Row="3" BorderBrush="#E2E8F0" BorderThickness="1,0,1,1"
                CornerRadius="0,0,10,10" Background="White" Padding="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Timeline"
                           FontSize="10" FontWeight="SemiBold" Foreground="#64748B"
                           HorizontalAlignment="Right" VerticalAlignment="Top"
                           Margin="0,6,12,0"/>

                <Canvas Grid.Column="1" Height="32" ClipToBounds="False">
                    <Rectangle Canvas.Left="0" Canvas.Top="0" Width="10000" Height="1" Fill="#E2E8F0"/>
                    <ItemsControl ItemsSource="{Binding Ticks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top"  Value="0"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Rectangle Fill="#94A3B8">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="Width"  Value="1"/>
                                                <Setter Property="Height" Value="4"/>
                                                <Setter Property="Fill"   Value="#CBD5E1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMajor}" Value="True">
                                                        <Setter Property="Height" Value="8"/>
                                                        <Setter Property="Fill"   Value="#6B7280"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                    <TextBlock Text="{Binding Label}" FontSize="10" Foreground="#64748B"
                                               Margin="-20,2,0,0" Width="60" TextAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </Grid>
        </Border>

    </Grid>
</UserControl>
