<UserControl x:Class="PMDashboard.Views.SitesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">

    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Page title + breadcrumb -->
            <RowDefinition Height="*"/>     <!-- Content panels -->
        </Grid.RowDefinitions>

        <!-- ── Page header: title + breadcrumb ── -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">

                <!-- Back-to-PM button — shown only when navigated from PM Detail -->
                <Button Content="{Binding BackButtonLabel}"
                        Padding="12,6" FontSize="12"
                        HorizontalAlignment="Left" Margin="0,0,0,14"
                        Click="BtnBackToPm_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasBackButton}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <TextBlock Text="Sites" FontSize="22" FontWeight="Bold"
                           Foreground="#0F172A" FontFamily="Segoe UI Semibold"/>

                <!-- Breadcrumb -->
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Button Content="Locations" Style="{StaticResource BreadcrumbBtnStyle}"
                            Click="BtnBreadcrumbRoot_Click"/>

                    <!-- › [LocationName] — visible at Sites + Romps levels -->
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAtSitesLevel}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsAtRompsLevel}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="  ›  " FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <Button Content="{Binding SelectedLocation.Name}"
                                Style="{StaticResource BreadcrumbBtnStyle}"
                                Click="BtnBreadcrumbLocation_Click"/>
                    </StackPanel>

                    <!-- › [SiteName] — visible at Romps level only, non-clickable (current) -->
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAtRompsLevel}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="  ›  " FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedSite.Name}" FontSize="13"
                                   Foreground="#0F172A" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Download Sites Template" x:Name="BtnDownloadSitesTemplate"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnDownloadSitesTemplate_Click" Margin="0,0,10,0"/>
                <Button Content="Import Sites" x:Name="BtnImportSites"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="BtnImportSites_Click"/>
            </StackPanel>
        </Grid>

        <!-- ════════════════════════════════════════════════════════
             LEVEL 1 — LOCATIONS
             ════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAtLocationsLevel}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="All locations — click a name to view its sites"
                           FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                <Button Content="+ Add Location" HorizontalAlignment="Right"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="BtnAddLocation_Click"/>
            </Grid>

            <!-- Locations search + filter bar -->
            <Border Grid.Row="1" Background="White" CornerRadius="8"
                    BorderBrush="#E2E8F0" BorderThickness="1"
                    Margin="0,0,0,10" Padding="10,0" Height="40">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔍" FontSize="12" Foreground="#94A3B8"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding LocationSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="160" BorderThickness="0" Background="Transparent"
                             FontSize="12" Foreground="#374151" FontFamily="Segoe UI"
                             VerticalAlignment="Center"/>
                    <Border Width="1" Background="#E2E8F0" Margin="10,6,10,6"/>
                    <TextBlock Text="Region:" FontSize="11" Foreground="#64748B"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox SelectedValue="{Binding LocationRegionFilter, Mode=TwoWay}"
                              SelectedValuePath="Content"
                              BorderThickness="0" Background="Transparent"
                              FontSize="12" Padding="4,0" Width="75" VerticalAlignment="Center">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="East"/>
                        <ComboBoxItem Content="Central"/>
                        <ComboBoxItem Content="West"/>
                    </ComboBox>
                    <Border Width="1" Background="#E2E8F0" Margin="10,6,10,6"/>
                    <CheckBox Content="Show Completed"
                              IsChecked="{Binding ShowCompletedLocations, Mode=TwoWay}"
                              FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1"
                    Background="White" ClipToBounds="True">
                <DataGrid x:Name="LocationsGrid"
                          Style="{StaticResource AppDataGridStyle}"
                          CellStyle="{StaticResource DataGridCellStyle}"
                          ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                          ItemsSource="{Binding FilteredLocations}"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Location" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}" Tag="{Binding}"
                                            Style="{StaticResource RowLinkStyle}"
                                            Click="BtnLocationLink_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Region"
                                            Binding="{Binding GeographicalLocation}" Width="80"/>
                        <DataGridTextColumn Header="Sites" Width="60">
                            <DataGridTextColumn.Binding>
                                <Binding Path="Sites.Count"/>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Actions" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Edit" Style="{StaticResource IconButtonStyle}"
                                                Tag="{Binding}" Click="BtnEditLocation_Click" Margin="0,0,6,0"/>
                                        <Button Content="Delete" Style="{StaticResource DangerButtonStyle}"
                                                Tag="{Binding}" Click="BtnDeleteLocation_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ════════════════════════════════════════════════════════
             LEVEL 2 — SITES
             ════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAtSitesLevel}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedLocation.Name, StringFormat='Sites in: {0}'}"
                               FontSize="15" FontWeight="SemiBold" Foreground="#1E293B"/>
                    <TextBlock Text="Click a site name to view its ROMPs"
                               FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Content="+ Add Site" HorizontalAlignment="Right"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="BtnAddSite_Click"/>
            </Grid>

            <!-- Sites search + filter bar -->
            <Border Grid.Row="1" Background="White" CornerRadius="8"
                    BorderBrush="#E2E8F0" BorderThickness="1"
                    Margin="0,0,0,10" Padding="10,0" Height="40">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔍" FontSize="12" Foreground="#94A3B8"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding SiteSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="140" BorderThickness="0" Background="Transparent"
                             FontSize="12" Foreground="#374151" FontFamily="Segoe UI"
                             VerticalAlignment="Center"/>
                    <Border Width="1" Background="#E2E8F0" Margin="10,6,10,6"/>
                    <TextBlock Text="Status:" FontSize="11" Foreground="#64748B"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox SelectedValue="{Binding SiteStatusFilter, Mode=TwoWay}"
                              SelectedValuePath="Content"
                              BorderThickness="0" Background="Transparent"
                              FontSize="12" Padding="4,0" Width="90" VerticalAlignment="Center">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Ordered"/>
                        <ComboBoxItem Content="Active"/>
                        <ComboBoxItem Content="Complete"/>
                    </ComboBox>
                    <Border Width="1" Background="#E2E8F0" Margin="10,6,10,6"/>
                    <TextBlock Text="PM:" FontSize="11" Foreground="#64748B"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding AvailablePmNames}"
                              SelectedItem="{Binding SitePmFilter, Mode=TwoWay}"
                              BorderThickness="0" Background="Transparent"
                              FontSize="12" Padding="4,0" Width="130" VerticalAlignment="Center"/>
                    <Border Width="1" Background="#E2E8F0" Margin="10,6,10,6"/>
                    <CheckBox Content="Show Completed"
                              IsChecked="{Binding ShowCompletedSites, Mode=TwoWay}"
                              FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1"
                    Background="White" ClipToBounds="True">
                <DataGrid x:Name="SitesGrid"
                          Style="{StaticResource AppDataGridStyle}"
                          CellStyle="{StaticResource DataGridCellStyle}"
                          ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                          ItemsSource="{Binding FilteredSites}"
                          BorderThickness="0">
                    <DataGrid.Columns>

                        <!-- Status ball -->
                        <DataGridTemplateColumn Header="" Width="34">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Ellipse Width="14" Height="14"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             ToolTipService.ToolTip="{Binding SiteStatus}">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#22C55E"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SiteStatus}" Value="Active">
                                                        <Setter Property="Fill" Value="#F59E0B"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SiteStatus}" Value="Complete">
                                                        <Setter Property="Fill" Value="#EF4444"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Site name — clickable link to ROMPs -->
                        <DataGridTemplateColumn Header="Site Name" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}" Tag="{Binding}"
                                            Style="{StaticResource RowLinkStyle}"
                                            Click="BtnSiteLink_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Assigned PM"
                                            Binding="{Binding AssignedPm.FullName}" Width="160"/>
                        <DataGridTextColumn Header="ROMPs" Width="65">
                            <DataGridTextColumn.Binding>
                                <Binding Path="Romps.Count"/>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Actions" Width="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Edit"   Style="{StaticResource IconButtonStyle}"
                                                Tag="{Binding}"  Click="BtnEditSite_Click"   Margin="0,0,6,0"/>
                                        <Button Content="Assign" Style="{StaticResource SecondaryButtonStyle}"
                                                Tag="{Binding}"  Click="BtnAssignPm_Click"
                                                Padding="8,4" FontSize="12" Margin="0,0,6,0"/>
                                        <Button Content="Delete" Style="{StaticResource DangerButtonStyle}"
                                                Tag="{Binding}"  Click="BtnDeleteSite_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ════════════════════════════════════════════════════════
             LEVEL 3 — ROMPS
             ════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAtRompsLevel}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="{Binding SelectedSite.Name, StringFormat='ROMPs in: {0}'}"
                           FontSize="15" FontWeight="SemiBold" Foreground="#1E293B"
                           VerticalAlignment="Center"/>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Content="Show All" Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnShowAllRomps_Click" Margin="0,0,8,0"/>
                    <Button Content="+ Add ROMP" Style="{StaticResource PrimaryButtonStyle}"
                            Click="BtnAddRomp_Click"/>
                </StackPanel>
            </Grid>

            <!-- ROMPs search + filter bar -->
            <Border Grid.Row="1" Background="White" CornerRadius="8"
                    BorderBrush="#E2E8F0" BorderThickness="1"
                    Margin="0,0,0,10" Padding="10,0" Height="40">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔍" FontSize="12" Foreground="#94A3B8"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding RompSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="160" BorderThickness="0" Background="Transparent"
                             FontSize="12" Foreground="#374151" FontFamily="Segoe UI"
                             VerticalAlignment="Center"/>
                    <Border Width="1" Background="#E2E8F0" Margin="10,6,10,6"/>
                    <TextBlock Text="Status:" FontSize="11" Foreground="#64748B"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding AvailableRompStatusFilters}"
                              SelectedItem="{Binding RompStatusFilter, Mode=TwoWay}"
                              BorderThickness="0" Background="Transparent"
                              FontSize="12" Padding="4,0" Width="110" VerticalAlignment="Center"/>
                    <Border Width="1" Background="#E2E8F0" Margin="10,6,10,6"/>
                    <CheckBox Content="Show Completed"
                              IsChecked="{Binding ShowCompletedRomps, Mode=TwoWay}"
                              FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1"
                    Background="White" ClipToBounds="True">
                <DataGrid x:Name="RompsGrid"
                          Style="{StaticResource AppDataGridStyle}"
                          CellStyle="{StaticResource DataGridCellStyle}"
                          ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                          ItemsSource="{Binding FilteredRomps}"
                          BorderThickness="0">
                    <DataGrid.Columns>

                        <DataGridTextColumn Header="ROMP Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Assigned PM"
                                            Binding="{Binding Site.AssignedPm.FullName}" Width="160"/>
                        <DataGridTextColumn Header="Region"
                                            Binding="{Binding GeographicalLocation}" Width="80"/>

                        <!-- Equipment types assigned to the ROMP -->
                        <DataGridTextColumn Header="Equipment"
                                            Binding="{Binding EquipmentTypesText}"
                                            Width="180"
                                            IsReadOnly="True"/>

                        <!-- ROMP score = activity_weight × equip_weight_sum -->
                        <DataGridTextColumn Header="Score"
                                            Binding="{Binding RompScore, StringFormat={}{0:F2}}"
                                            Width="65"
                                            IsReadOnly="True"/>

                        <!-- Status + Edit + Delete combined column -->
                        <DataGridTemplateColumn Header="Actions" Width="310">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                        <!-- Color indicator dot -->
                                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#94A3B8"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="OFCI">
                                                            <Setter Property="Fill" Value="#2563EB"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Construction">
                                                            <Setter Property="Fill" Value="#F59E0B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="CX">
                                                            <Setter Property="Fill" Value="#F97316"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Complete">
                                                            <Setter Property="Fill" Value="#22C55E"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <!-- Quick-change dropdown (items bound to ViewModel's StatusConfig list) -->
                                        <ComboBox Tag="{Binding}"
                                                  ItemsSource="{Binding DataContext.AvailableRompStatusNames, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding Status, Mode=OneWay}"
                                                  Width="118" FontSize="12"
                                                  BorderBrush="#E2E8F0" BorderThickness="1"
                                                  Background="White" Padding="6,3"
                                                  SelectionChanged="CboRompStatus_SelectionChanged"/>

                                        <!-- Edit / Delete buttons with left margin -->
                                        <Button Content="Edit" Style="{StaticResource IconButtonStyle}"
                                                Tag="{Binding}" Click="BtnEditRomp_Click"
                                                Margin="16,0,6,0"/>
                                        <Button Content="Delete" Style="{StaticResource DangerButtonStyle}"
                                                Tag="{Binding}" Click="BtnDeleteRomp_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
