<UserControl x:Class="PMDashboard.Views.OrdersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">

    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Orders" FontSize="22" FontWeight="Bold"
                           Foreground="#0F172A" FontFamily="Segoe UI Semibold"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Imported spreadsheet data  •  " FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding TotalCount, StringFormat={}{0} records}"
                               FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding LastUploadDate, StringFormat='  •  Last updated: {0}'}"
                               FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Clear All" x:Name="BtnClear"
                        Style="{StaticResource DangerButtonStyle}"
                        Click="BtnClear_Click" Margin="0,0,10,0"/>
                <Button x:Name="BtnImport"
                        Click="BtnImport_Click" IsEnabled="{Binding IsNotImporting}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="Content" Value="Import Excel"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsImporting}" Value="True">
                                    <Setter Property="Content" Value="Importing…"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Importing indicator -->
        <Border Grid.Row="1" Background="#EFF6FF" CornerRadius="8" BorderBrush="#BFDBFE" BorderThickness="1"
                Padding="14,10" Margin="0,0,0,16">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsImporting}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ImportingStatus}" FontSize="13" Foreground="#1D4ED8" FontWeight="SemiBold"/>
        </Border>

        <!-- Last Import results card — persists until the next import, replaces the old one-shot popup -->
        <Border Grid.Row="2" Background="White" CornerRadius="10"
                BorderBrush="#E2E8F0" BorderThickness="1" Padding="24,20" VerticalAlignment="Top">
            <StackPanel>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasLastImport}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Last Import" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding LastImportHeadline}" FontSize="20" FontWeight="SemiBold"
                               Foreground="#111827" Margin="0,10,0,4"/>
                    <TextBlock Text="{Binding LastImportDetails}" FontSize="13" Foreground="#64748B" Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding LastImportWhen}" FontSize="12" Foreground="#94A3B8"/>
                        <TextBlock Text="  •  " FontSize="12" Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding LastImportBy}" FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasLastImport}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="No imports yet this session" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A"/>
                    <TextBlock Text="Import an Excel file to see a summary of what changed here."
                               FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
