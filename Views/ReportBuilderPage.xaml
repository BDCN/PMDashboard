<UserControl x:Class="PMDashboard.Views.ReportBuilderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">

    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Title -->
            <RowDefinition Height="*"/>     <!-- Content -->
        </Grid.RowDefinitions>

        <!-- ── Title ── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Report Builder" FontSize="22" FontWeight="Bold"
                       Foreground="#0F172A" FontFamily="Segoe UI Semibold"/>
            <TextBlock Text="Build a custom report, filter the data, and save it for later"
                       FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ── Two-column body ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>  <!-- Filters -->
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>    <!-- Results + chart -->
            </Grid.ColumnDefinitions>

            <!-- ══ LEFT: Filters ══ -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Report Type -->
                    <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0"
                            BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Report Type" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#374151" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RbModeOrders" Content="Orders" GroupName="ReportModeGroup"
                                             IsChecked="{Binding IsOrdersMode, Mode=OneWay}"
                                             Click="RbModeOrders_Click" Margin="0,0,20,0"
                                             FontSize="13" FontFamily="Segoe UI" Foreground="#111827"/>
                                <RadioButton x:Name="RbModeSitesRomps" Content="Sites &amp; ROMPs" GroupName="ReportModeGroup"
                                             IsChecked="{Binding IsSitesRompMode, Mode=OneWay}"
                                             Click="RbModeSitesRomps_Click"
                                             FontSize="13" FontFamily="Segoe UI" Foreground="#111827"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Date Range -->
                    <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0"
                            BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Date Range" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#374151" Margin="0,0,0,8"/>
                            <ComboBox ItemsSource="{Binding DateFieldOptions}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding SelectedDateField, Mode=TwoWay}"
                                      Style="{StaticResource FormComboBoxStyle}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="From" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                    <DatePicker SelectedDate="{Binding DateFrom, Mode=TwoWay}"
                                                Style="{StaticResource FormDatePickerStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="To" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                    <DatePicker SelectedDate="{Binding DateTo, Mode=TwoWay}"
                                                Style="{StaticResource FormDatePickerStyle}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Search -->
                    <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0"
                            BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Search" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#374151" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding TextSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Locations (Sites & ROMPs mode only) -->
                    <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0"
                            BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSitesRompMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Clusters" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#374151" HorizontalAlignment="Left"/>
                                <Button Content="Clear" HorizontalAlignment="Right"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="8,2" FontSize="10" Click="BtnClearLocations_Click"/>
                            </Grid>
                            <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" MaxHeight="140">
                                <ListBox x:Name="LocationsListBox" ItemsSource="{Binding AllLocations}"
                                         DisplayMemberPath="Name" SelectionMode="Extended"
                                         BorderThickness="0" Background="White" FontSize="12"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         SelectionChanged="LocationsListBox_SelectionChanged"/>
                            </Border>
                            <TextBlock Text="{Binding LocationSelectionInfo}" FontSize="11"
                                       Foreground="#64748B" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Sites (Sites & ROMPs mode only) -->
                    <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0"
                            BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSitesRompMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Sites" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#374151" HorizontalAlignment="Left"/>
                                <Button Content="Clear" HorizontalAlignment="Right"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="8,2" FontSize="10" Click="BtnClearSites_Click"/>
                            </Grid>
                            <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" MaxHeight="140">
                                <ListBox x:Name="SitesListBox" ItemsSource="{Binding AllSites}"
                                         DisplayMemberPath="Name" SelectionMode="Extended"
                                         BorderThickness="0" Background="White" FontSize="12"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         SelectionChanged="SitesListBox_SelectionChanged"/>
                            </Border>
                            <TextBlock Text="{Binding SiteSelectionInfo}" FontSize="11"
                                       Foreground="#64748B" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ROMP Status (Sites & ROMPs mode only) -->
                    <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0"
                            BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSitesRompMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="ROMP Status" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#374151" HorizontalAlignment="Left"/>
                                <Button Content="Clear" HorizontalAlignment="Right"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="8,2" FontSize="10" Click="BtnClearRompStatuses_Click"/>
                            </Grid>
                            <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" MaxHeight="120">
                                <ListBox x:Name="RompStatusesListBox" ItemsSource="{Binding AllRompStatuses}"
                                         SelectionMode="Extended"
                                         BorderThickness="0" Background="White" FontSize="12"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         SelectionChanged="RompStatusesListBox_SelectionChanged"/>
                            </Border>
                            <TextBlock Text="{Binding RompStatusSelectionInfo}" FontSize="11"
                                       Foreground="#64748B" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Order Status (Orders mode only) -->
                    <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0"
                            BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOrdersMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Order Status" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#374151" HorizontalAlignment="Left"/>
                                <Button Content="Clear" HorizontalAlignment="Right"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="8,2" FontSize="10" Click="BtnClearOrderStatuses_Click"/>
                            </Grid>
                            <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" MaxHeight="120">
                                <ListBox x:Name="OrderStatusesListBox" ItemsSource="{Binding AllOrderStatuses}"
                                         SelectionMode="Extended"
                                         BorderThickness="0" Background="White" FontSize="12"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         SelectionChanged="OrderStatusesListBox_SelectionChanged"/>
                            </Border>
                            <TextBlock Text="{Binding OrderStatusSelectionInfo}" FontSize="11"
                                       Foreground="#64748B" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Project Managers (both modes) -->
                    <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0"
                            BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Project Managers" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#374151" HorizontalAlignment="Left"/>
                                <Button Content="Clear" HorizontalAlignment="Right"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="8,2" FontSize="10" Click="BtnClearPms_Click"/>
                            </Grid>
                            <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" MaxHeight="140">
                                <ListBox x:Name="PmsListBox" ItemsSource="{Binding AllPms}"
                                         DisplayMemberPath="FullName" SelectionMode="Extended"
                                         BorderThickness="0" Background="White" FontSize="12"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         SelectionChanged="PmsListBox_SelectionChanged"/>
                            </Border>
                            <TextBlock Text="{Binding PmSelectionInfo}" FontSize="11"
                                       Foreground="#64748B" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Columns -->
                    <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0"
                            BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Columns" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#374151" Margin="0,0,0,8"/>
                            <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" MaxHeight="220">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="ColumnPickerPanel" Margin="8"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Run -->
                    <Button Content="Run Report" Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Stretch" Padding="14,10" FontSize="14"
                            Click="BtnRunReport_Click" Margin="0,0,0,10"/>

                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#16A34A"
                               TextWrapping="Wrap" Margin="0,0,0,20"/>

                </StackPanel>
            </ScrollViewer>

            <!-- ══ RIGHT: Saved reports + Results + Chart ══ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Saved reports strip -->
                    <RowDefinition Height="2*"/>     <!-- Results grid -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>  <!-- Chart controls -->
                    <RowDefinition Height="1*"/>     <!-- Chart bars -->
                </Grid.RowDefinitions>

                <!-- Saved Reports strip -->
                <Border Grid.Row="0" Background="White" CornerRadius="10" BorderBrush="#E2E8F0"
                        BorderThickness="1" Padding="16,12" Margin="0,0,0,12">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Saved Reports:" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#374151" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CboSavedReports" Width="200"
                                  ItemsSource="{Binding SavedReports}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedSavedReport, Mode=TwoWay}"
                                  Style="{StaticResource FormComboBoxStyle}" Margin="0,0,8,0"/>
                        <Button Content="Load" Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10,6" Margin="0,0,6,0" Click="BtnLoadSavedReport_Click"/>
                        <Button Content="Save As" Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10,6" Margin="0,0,6,0" Click="BtnSaveAsNew_Click"/>
                        <Button Content="Update" Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10,6" Margin="0,0,6,0" Click="BtnUpdateSavedReport_Click"/>
                        <Button Content="Rename" Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10,6" Margin="0,0,6,0" Click="BtnRenameSavedReport_Click"/>
                        <Button Content="Delete" Style="{StaticResource DangerButtonStyle}"
                                Padding="10,6" Margin="0,0,16,0" Click="BtnDeleteSavedReport_Click"/>
                        <Button Content="Export to Excel" Style="{StaticResource PrimaryButtonStyle}"
                                Padding="10,6" Click="BtnExportExcel_Click"/>
                    </WrapPanel>
                </Border>

                <!-- Results grid -->
                <Border Grid.Row="1" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1"
                        Background="White" ClipToBounds="True">
                    <DataGrid x:Name="ResultsGrid"
                              Style="{StaticResource AppDataGridStyle}"
                              CellStyle="{StaticResource DataGridCellStyle}"
                              ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                              ItemsSource="{Binding Results}"
                              BorderThickness="0"/>
                </Border>

                <!-- Chart controls -->
                <Border Grid.Row="3" Background="White" CornerRadius="10" BorderBrush="#E2E8F0"
                        BorderThickness="1" Padding="16,12" Margin="0,0,0,10">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Chart — Group by:" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#374151" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Width="160" ItemsSource="{Binding AvailableFields}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding ChartGroupByField, Mode=TwoWay}"
                                  Style="{StaticResource FormComboBoxStyle}" Margin="0,0,16,0"/>

                        <RadioButton x:Name="RbAggCount" Content="Count of rows" GroupName="ChartAggGroup"
                                     IsChecked="True" Click="RbAggCount_Click"
                                     VerticalAlignment="Center" Margin="0,0,14,0"
                                     FontSize="12" FontFamily="Segoe UI" Foreground="#111827"/>
                        <RadioButton x:Name="RbAggSum" Content="Sum of:" GroupName="ChartAggGroup"
                                     Click="RbAggSum_Click"
                                     VerticalAlignment="Center" Margin="0,0,6,0"
                                     FontSize="12" FontFamily="Segoe UI" Foreground="#111827"/>
                        <ComboBox Width="160" ItemsSource="{Binding ChartAggregateOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding ChartAggregateField, Mode=TwoWay}"
                                  Style="{StaticResource FormComboBoxStyle}"/>
                    </WrapPanel>
                </Border>

                <!-- Chart bars -->
                <Border Grid.Row="4" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1"
                        Background="White" ClipToBounds="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="ChartGrid" ClipToBounds="True" SizeChanged="ChartGrid_SizeChanged">
                            <ItemsControl ItemsSource="{Binding ChartData}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="30">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.ColumnSpan="2" BorderBrush="#F1F5F9"
                                                    BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Margin="0,0,10,0" FontSize="11" Foreground="#374151"
                                                       FontFamily="Segoe UI" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Rectangle Width="{Binding BarWidth}" Height="18"
                                                           Fill="#2563EB" SnapsToDevicePixels="True"/>
                                                <TextBlock Text="{Binding ValueText}" VerticalAlignment="Center"
                                                           Margin="8,0,0,0" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="#374151" FontFamily="Segoe UI"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Border>

            </Grid>
        </Grid>
    </Grid>
</UserControl>
