<UserControl x:Class="PMDashboard.Views.PmDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Back + title -->
            <RowDefinition Height="Auto"/>  <!-- PM info card -->
            <RowDefinition Height="Auto"/>  <!-- Summary KPI cards -->
            <RowDefinition Height="Auto"/>  <!-- ROMP breakdown -->
            <RowDefinition Height="Auto"/>  <!-- Sites table -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Back button + title ── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <Button Content="← Back to Workload" HorizontalAlignment="Left"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="12,6" FontSize="12" Margin="0,0,0,16"
                    Click="BtnBack_Click"/>
            <TextBlock Text="{Binding PmName}" FontSize="24" FontWeight="Bold"
                       Foreground="#0F172A" FontFamily="Segoe UI Semibold"/>
            <TextBlock FontSize="13" Foreground="#64748B" Margin="0,4,0,0">
                <Run Text="Project Manager"/>
                <Run Text=" · "/>
                <Run Text="{Binding HomeOffice}"/>
                <Run Text=" · "/>
                <Run Text="{Binding Region}"/>
            </TextBlock>
        </StackPanel>

        <!-- ── PM info card ── -->
        <Border Grid.Row="1" Background="White" CornerRadius="10"
                BorderBrush="#E2E8F0" BorderThickness="1" Padding="24,16" Margin="0,0,0,16">
            <WrapPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,40,0">
                    <TextBlock Text="DATA NAME" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock Text="{Binding DataName}" FontSize="15" FontWeight="SemiBold"
                               Foreground="#0F172A" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Margin="0,0,40,0">
                    <TextBlock Text="CAPACITY" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock Text="{Binding CapacityText}" FontSize="15" FontWeight="SemiBold"
                               Foreground="#0F172A" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Margin="0,0,40,0">
                    <TextBlock Text="IDEAL UTILIZATION" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock Text="{Binding IdealText}" FontSize="15" FontWeight="SemiBold"
                               Foreground="#0F172A" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Margin="0,0,40,0">
                    <TextBlock Text="CURRENT UTILIZATION" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock Text="{Binding UtilizationText}" FontSize="15" FontWeight="SemiBold"
                               Foreground="#2563EB" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Margin="0,0,40,0">
                    <TextBlock Text="PM MULTIPLIER" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"
                               ToolTipService.ToolTip="Experience multiplier 1–10. Scales effective capacity in Score mode."/>
                    <TextBlock Text="{Binding PmMultiplierText}" FontSize="15" FontWeight="SemiBold"
                               Foreground="#0F172A" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="EFF. CAPACITY" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"
                               ToolTipService.ToolTip="Effective capacity = Target Capacity × skill_factor (Score mode denominator)"/>
                    <TextBlock Text="{Binding EffCapacityText}" FontSize="15" FontWeight="SemiBold"
                               Foreground="#0F172A" Margin="0,2,0,0"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ── Summary KPI cards ── -->
        <Border Grid.Row="2" Background="White" CornerRadius="10"
                BorderBrush="#E2E8F0" BorderThickness="1" Padding="20,16" Margin="0,0,0,16">
            <WrapPanel Orientation="Horizontal">

                <!-- Active sites -->
                <Border Background="#EFF6FF" CornerRadius="8" Padding="20,12" Margin="0,0,12,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse Width="8" Height="8" Fill="#2563EB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="ACTIVE SITES" FontSize="10" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ActiveSiteCount}" FontSize="28" FontWeight="Bold" Foreground="#2563EB"/>
                        <TextBlock Text="non-complete sites" FontSize="11" Foreground="#3B82F6" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Completed sites -->
                <Border Background="#F0FDF4" CornerRadius="8" Padding="20,12" Margin="0,0,12,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse Width="8" Height="8" Fill="#16A34A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="COMPLETED SITES" FontSize="10" FontWeight="SemiBold" Foreground="#166534"/>
                        </StackPanel>
                        <TextBlock Text="{Binding CompletedSiteCount}" FontSize="28" FontWeight="Bold" Foreground="#16A34A"/>
                        <TextBlock Text="all ROMPs done" FontSize="11" Foreground="#15803D" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Active ROMPs -->
                <Border Background="#FFF7ED" CornerRadius="8" Padding="20,12" Margin="0,0,12,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse Width="8" Height="8" Fill="#EA580C" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="ACTIVE ROMPs" FontSize="10" FontWeight="SemiBold" Foreground="#9A3412"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ActiveRompCount}" FontSize="28" FontWeight="Bold" Foreground="#EA580C"/>
                        <TextBlock Text="non-complete ROMPs" FontSize="11" Foreground="#C2410C" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Total ROMPs -->
                <Border Background="#F8FAFC" CornerRadius="8" Padding="20,12" Margin="0,0,12,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse Width="8" Height="8" Fill="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="TOTAL ROMPs" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalRompCount}" FontSize="28" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="all statuses incl. complete" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- PM Load / Availability -->
                <Border Background="#FDF4FF" CornerRadius="8" Padding="20,12" Margin="0,0,0,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse Width="8" Height="8" Fill="#9333EA" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="PM LOAD" FontSize="10" FontWeight="SemiBold" Foreground="#6B21A8"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PmLoadText}" FontSize="28" FontWeight="Bold" Foreground="#9333EA"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding AvailabilityText, StringFormat='Avail: {0}'}"
                                       FontSize="10" Foreground="#A855F7"/>
                            <TextBlock Text="  ·  " FontSize="10" Foreground="#C4B5FD"/>
                            <TextBlock Text="{Binding PmStatus}" FontSize="10" Foreground="#A855F7"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </WrapPanel>
        </Border>

        <!-- ── ROMP Status Breakdown ── -->
        <Border Grid.Row="3" Background="White" CornerRadius="10"
                BorderBrush="#E2E8F0" BorderThickness="1" Padding="24,20" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="ROMP Status Breakdown" FontSize="16" FontWeight="SemiBold"
                           Foreground="#0F172A" Margin="0,0,0,16"/>

                <ItemsControl ItemsSource="{Binding RompBreakdown}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>  <!-- Status label -->
                                    <ColumnDefinition Width="Auto"/> <!-- Bar -->
                                    <ColumnDefinition Width="50"/>   <!-- Count -->
                                    <ColumnDefinition Width="60"/>   <!-- Score wt -->
                                    <ColumnDefinition Width="80"/>   <!-- Status score -->
                                </Grid.ColumnDefinitions>

                                <!-- Status name -->
                                <TextBlock Grid.Column="0" Text="{Binding Status}"
                                           FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#374151"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Status bar -->
                                <Border Grid.Column="1" Height="22" CornerRadius="4"
                                        Width="{Binding BarWidth}" MinWidth="4"
                                        HorizontalAlignment="Left" Margin="0,0,12,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#94A3B8"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Ordered">
                                                    <Setter Property="Background" Value="#94A3B8"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="OFCI">
                                                    <Setter Property="Background" Value="#2563EB"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Construction">
                                                    <Setter Property="Background" Value="#F59E0B"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="CX">
                                                    <Setter Property="Background" Value="#F97316"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Complete">
                                                    <Setter Property="Background" Value="#22C55E"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!-- Count -->
                                <TextBlock Grid.Column="2" Text="{Binding Count}"
                                           FontSize="13" FontWeight="Bold" Foreground="#0F172A"
                                           VerticalAlignment="Center"/>

                                <!-- Activity multiplier per ROMP -->
                                <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                           FontSize="11" Foreground="#64748B" Margin="8,0,0,0">
                                    <Run Text="×"/>
                                    <Run Text="{Binding ScoreWeight, StringFormat={}{0:F1}}"/>
                                </TextBlock>

                                <!-- Total score contribution from this status group -->
                                <TextBlock Grid.Column="4"
                                           Text="{Binding StatusScore, StringFormat={}{0:F2}}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="#9333EA"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Score breakdown footer -->
                <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ROMP sum: " FontSize="12" Foreground="#64748B"/>
                        <TextBlock Text="{Binding RompScoreSum, StringFormat={}{0:F2}}" FontSize="12" FontWeight="Bold" Foreground="#9333EA" Margin="0,0,8,0"/>
                        <TextBlock Text="× site factor " FontSize="12" Foreground="#64748B"/>
                        <TextBlock Text="{Binding SiteFactorValue, StringFormat={}{0:F2}}" FontSize="12" FontWeight="Bold" Foreground="#9333EA" Margin="0,0,8,0"/>
                        <TextBlock Text="= PM Load: " FontSize="12" Foreground="#64748B"/>
                        <TextBlock Text="{Binding PmLoadText}" FontSize="13" FontWeight="Bold" Foreground="#9333EA"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ── Sites table ── -->
        <Border Grid.Row="4" Background="White" CornerRadius="10"
                BorderBrush="#E2E8F0" BorderThickness="1" Padding="24,20" Margin="0,0,0,16">
            <StackPanel>
                <!-- Header row: title + select-all + bulk-unassign -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Assigned Sites" FontSize="16"
                               FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="ChkSelectAll" Content="Select All"
                                  FontSize="12" FontFamily="Segoe UI" Foreground="#374151"
                                  VerticalAlignment="Center" Click="ChkSelectAll_Click"
                                  Margin="0,0,16,0"/>
                        <Button x:Name="BtnUnassignSelected"
                                Content="Unassign Selected"
                                Style="{StaticResource DangerButtonStyle}"
                                Padding="12,6" FontSize="12"
                                Click="BtnUnassignSelected_Click"/>
                    </StackPanel>
                </Grid>

                <Border CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
                    <DataGrid x:Name="SitesGrid"
                              Style="{StaticResource AppDataGridStyle}"
                              CellStyle="{StaticResource DataGridCellStyle}"
                              ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                              ItemsSource="{Binding Sites}"
                              BorderThickness="0" IsReadOnly="True">
                        <DataGrid.Columns>

                            <!-- Selection checkbox (bulk unassign) -->
                            <DataGridTemplateColumn Width="42" CanUserSort="False" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay,
                                                              UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Click="SiteCheckBox_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Status indicator dot -->
                            <DataGridTemplateColumn Header="" Width="34">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="12" Height="12"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 ToolTipService.ToolTip="{Binding SiteStatus}">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#22C55E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SiteStatus}" Value="Active">
                                                            <Setter Property="Fill" Value="#F59E0B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SiteStatus}" Value="Complete">
                                                            <Setter Property="Fill" Value="#94A3B8"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Site Name — clickable link to drill into ROMs -->
                            <DataGridTemplateColumn Header="Site Name" Width="*" SortMemberPath="SiteName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding}"
                                                Click="BtnSiteLink_Click"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background"   Value="Transparent"/>
                                                    <Setter Property="BorderBrush"  Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Padding"      Value="4,0"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <ContentPresenter/>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="{Binding SiteName}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#2563EB" TextDecorations="Underline"
                                                       ToolTipService.ToolTip="Click to view ROMs for this site"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Location" Binding="{Binding Location}"   Width="90"/>
                            <DataGridTextColumn Header="Status"   Binding="{Binding SiteStatus}" Width="90"/>
                            <DataGridTextColumn Header="ROMs"
                                                Binding="{Binding ActiveRomps}" Width="70"/>
                            <DataGridTextColumn Header="Score"
                                                Binding="{Binding SiteScore, StringFormat={}{0:F2}}"
                                                Width="70"/>

                            <!-- Edit button -->
                            <DataGridTemplateColumn Header="" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Edit" Tag="{Binding}"
                                                Click="BtnEditSite_Click"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="8,4" FontSize="11"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Unassign button -->
                            <DataGridTemplateColumn Header="" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Unassign" Tag="{Binding}"
                                                Click="BtnUnassignSite_Click"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Padding="8,4" FontSize="11"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>
        </Border>

    </Grid>
    </ScrollViewer>
</UserControl>
