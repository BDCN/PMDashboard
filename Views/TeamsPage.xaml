<UserControl x:Class="PMDashboard.Views.TeamsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">

    <UserControl.Resources>
        <!-- Same flat tab strip as the Coverage Planner -->
        <Style x:Key="TeamsTabStyle" TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Padding="16,10" Margin="0,0,4,0" BorderThickness="0,0,0,3"
                                BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Buttons that change teams: shown only to Super Admins / Directors (IsEditable) -->
        <Style x:Key="EditOnly" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Title ── -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditable}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Button Content="+ Director" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="BtnAddDirector_Click"/>
                <Button Content="+ PE" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="BtnAddPe_Click"/>
                <Button Content="+ PA" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="BtnAddPa_Click"/>
                <Button Content="+ Sub-region" Style="{StaticResource PrimaryButtonStyle}" Click="BtnAddSubRegion_Click"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Teams" FontSize="22" FontWeight="Bold" Foreground="#0F172A" FontFamily="Segoe UI Semibold"/>
                <TextBlock FontSize="13" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Director (region) › Project Executive (sub-region) › Platform Manager › Project Administrator. A cluster can only be assigned to PMs on its sub-region's team; a cluster without a sub-region, to PMs in its region."/>
            </StackPanel>
        </DockPanel>

        <!-- Status / read-only note -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#16A34A" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="View only — teams can be changed by Super Admins and Directors." FontSize="12" Foreground="#94A3B8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditable}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- ── Tabs ── -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1">
            <TabControl Background="Transparent" BorderThickness="0" Padding="20,12,20,16">
                <TabControl.Resources>
                    <Style TargetType="TabItem" BasedOn="{StaticResource TeamsTabStyle}"/>
                </TabControl.Resources>

                <!-- ═══ Org chart ═══ -->
                <TabItem Header="Org Chart">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HintStyle}"
                                       Text="Active people only. PMs without a team are listed under their region until they're put under a PE (People tab → Edit)."/>
                            <TextBlock Text="No teams yet — add a Director, a sub-region and its PE, then put PMs under the PE." FontSize="13" Foreground="#94A3B8" Margin="0,8,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OrgChart.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding OrgChart}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8"
                                                Padding="16,12" Margin="0,0,0,12">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Region}" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A"/>
                                                    <TextBlock Text="  ·  Director: " FontSize="13" Foreground="#64748B" VerticalAlignment="Bottom"/>
                                                    <TextBlock Text="{Binding Directors, TargetNullValue='—'}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="#0F172A" VerticalAlignment="Bottom"/>
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding SubRegions}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8"
                                                                    Padding="12,10" Margin="0,0,10,10" Width="300">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#2563EB"/>
                                                                    <TextBlock FontSize="12" Foreground="#374151" Margin="0,2,0,0" TextWrapping="Wrap">
                                                                        <Run Text="PE: " Foreground="#64748B"/><Run Text="{Binding Pes, Mode=OneWay}" FontWeight="SemiBold"/>
                                                                    </TextBlock>
                                                                    <TextBlock FontSize="11" Foreground="#64748B" Margin="0,2,0,2" TextWrapping="Wrap">
                                                                        <Run Text="Clusters: "/><Run Text="{Binding Clusters, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                    <TextBlock FontSize="11" Foreground="#7C3AED" Margin="0,0,0,2" TextWrapping="Wrap">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasCampuses}" Value="False">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                        <Run Text="Plus campuses: "/><Run Text="{Binding Campuses, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                    <Border Height="4"/>
                                                                    <ItemsControl ItemsSource="{Binding Pms}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock FontSize="12" Margin="8,1,0,1" TextWrapping="Wrap">
                                                                                    <Run Text="• "/><Run Text="{Binding Name, Mode=OneWay}" Foreground="#0F172A"/>
                                                                                    <Run Text="{Binding Detail, Mode=OneWay, StringFormat='  {0}'}" Foreground="#94A3B8"/>
                                                                                </TextBlock>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <StackPanel>
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasPmsWithoutTeam}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="PMs without a team — they can only take this region's clusters that have no sub-region yet"
                                                               FontSize="12" FontWeight="SemiBold" Foreground="#D97706" Margin="0,2,0,4"/>
                                                    <ItemsControl ItemsSource="{Binding PmsWithoutTeam}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4"
                                                                        Padding="8,3" Margin="0,0,6,6">
                                                                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#92400E"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ═══ People ═══ -->
                <TabItem Header="People">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Role" FontSize="12" Foreground="#374151" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CboRoleFilter" Width="110" Height="32" VerticalAlignment="Center" SelectedItem="{Binding PeopleRoleFilter, Mode=TwoWay}"
                                      Style="{StaticResource FormComboBoxStyle}"/>
                            <TextBlock Text="🔍" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="16,0,6,0"/>
                            <TextBox Text="{Binding PeopleSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="200" Height="32" VerticalAlignment="Center"
                                     Style="{StaticResource FormTextBoxStyle}" ToolTipService.ToolTip="Name, email, sub-region or manager"/>
                            <CheckBox Content="Show inactive" IsChecked="{Binding ShowInactive, Mode=TwoWay}" FontSize="12"
                                      Foreground="#374151" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </StackPanel>
                        <Border Grid.Row="1" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
                            <DataGrid Style="{StaticResource AppDataGridStyle}"
                                      CellStyle="{StaticResource DataGridCellStyle}"
                                      ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                      ItemsSource="{Binding FilteredPeople}" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="85"/>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170"/>
                                    <DataGridTextColumn Header="Region" Binding="{Binding Region}" Width="80"/>
                                    <DataGridTextColumn Header="Sub-region" Binding="{Binding SubRegion}" Width="100"/>
                                    <DataGridTextColumn Header="Reports to" Binding="{Binding ReportsTo}" Width="170"/>
                                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>
                                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="110"/>
                                    <DataGridTextColumn Header="Active" Binding="{Binding ActiveText}" Width="60"/>
                                    <DataGridTemplateColumn Header="" Width="*" MinWidth="230">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Style="{StaticResource EditOnly}">
                                                    <Button Content="Edit" Tag="{Binding}" Style="{StaticResource SecondaryButtonStyle}"
                                                            Padding="10,3" FontSize="11" Margin="0,0,6,0" Click="BtnEditPerson_Click"/>
                                                    <Button Tag="{Binding}" Padding="10,3" FontSize="11" Margin="0,0,6,0" Click="BtnToggleActive_Click">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                                <Setter Property="Content" Value="Deactivate"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                        <Setter Property="Content" Value="Activate"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsPm}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="Delete" Tag="{Binding}" Padding="10,3" FontSize="11" Click="BtnDeletePerson_Click">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPm}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ═══ Sub-regions & clusters ═══ -->
                <TabItem Header="Sub-regions &amp; Clusters">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="560"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Sub-regions -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource HintStyle}"
                                       Text="Each sub-region belongs to a region and is controlled by a PE. Deleting one unmaps its clusters."/>
                            <Border Grid.Row="1" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
                                <DataGrid Style="{StaticResource AppDataGridStyle}"
                                          CellStyle="{StaticResource DataGridCellStyle}"
                                          ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                          ItemsSource="{Binding SubRegions}" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Sub-region" Binding="{Binding Name}" Width="90"/>
                                        <DataGridTextColumn Header="Region" Binding="{Binding Region}" Width="75"/>
                                        <DataGridTextColumn Header="PE" Binding="{Binding Pes}" Width="120"/>
                                        <DataGridTextColumn Header="Clusters" Binding="{Binding Clusters}" Width="65"/>
                                        <DataGridTextColumn Header="+Campuses" Binding="{Binding Campuses}" Width="75"/>
                                        <DataGridTextColumn Header="PMs" Binding="{Binding Pms}" Width="50"/>
                                        <DataGridTemplateColumn Header="" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Style="{StaticResource EditOnly}">
                                                        <Button Content="Edit" Tag="{Binding}" Style="{StaticResource SecondaryButtonStyle}"
                                                                Padding="8,3" FontSize="11" Margin="0,0,4,0" Click="BtnEditSubRegion_Click"/>
                                                        <Button Content="✕" Tag="{Binding}" Style="{StaticResource DangerButtonStyle}"
                                                                Padding="8,3" FontSize="11" ToolTipService.ToolTip="Delete sub-region"
                                                                Click="BtnDeleteSubRegion_Click"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>

                        <!-- Clusters -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource HintStyle}">
                                <Run Text="Set each cluster's sub-region (e.g. IAD → East 1). To split a cluster, select it and give individual campuses their own sub-region below. Existing assignments are kept; any now outside their team appear on the Conflicts tab."/>
                                <Run Text="{Binding UnmappedCount, Mode=OneWay, StringFormat=' {0} cluster(s) have no sub-region yet.'}" Foreground="#D97706"/>
                            </TextBlock>
                            <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                                <TextBlock Text="Region" FontSize="12" Foreground="#374151" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{Binding ClusterRegionFilters}" SelectedItem="{Binding ClusterRegionFilter, Mode=TwoWay}"
                                          Width="100" Height="32" VerticalAlignment="Center" Style="{StaticResource FormComboBoxStyle}"/>
                                <TextBlock Text="🔍" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="12,0,6,0"/>
                                <TextBox Text="{Binding ClusterSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="140" Height="32" VerticalAlignment="Center"
                                         Style="{StaticResource FormTextBoxStyle}" ToolTipService.ToolTip="Cluster code or PM name"/>
                                <CheckBox Content="No sub-region only" IsChecked="{Binding UnmappedOnly, Mode=TwoWay}" FontSize="12"
                                          Foreground="#374151" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" Style="{StaticResource EditOnly}">
                                    <TextBlock Text="Set selected to" FontSize="12" Foreground="#374151" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CboBulkSubRegion" ItemsSource="{Binding SubRegionOptions}" DisplayMemberPath="Name"
                                              Width="150" Height="32" VerticalAlignment="Center" Style="{StaticResource FormComboBoxStyle}"/>
                                    <Button Content="Apply" Style="{StaticResource PrimaryButtonStyle}" Margin="6,0,0,0" VerticalAlignment="Center"
                                            Click="BtnBulkSetSubRegion_Click"/>
                                </StackPanel>
                            </WrapPanel>
                            <Border Grid.Row="2" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
                                <DataGrid x:Name="ClustersGrid"
                                          Style="{StaticResource AppDataGridStyle}"
                                          CellStyle="{StaticResource DataGridCellStyle}"
                                          ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                          ItemsSource="{Binding FilteredClusters}" SelectionMode="Extended" BorderThickness="0"
                                          SelectedItem="{Binding SelectedCluster, Mode=TwoWay}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Cluster" Binding="{Binding Name}" Width="70"/>
                                        <DataGridTextColumn Header="Region" Binding="{Binding Region}" Width="70"/>
                                        <DataGridTemplateColumn Header="Sub-region" Width="170" SortMemberPath="SubRegionKey">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding DataContext.SubRegionOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              DisplayMemberPath="Name" SelectedValuePath="Id"
                                                              SelectedValue="{Binding SubRegionKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              FontSize="12" Margin="0,2"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Split" Binding="{Binding SplitInfo}" Width="190"/>
                                        <DataGridTextColumn Header="Assigned PMs" Binding="{Binding Pms}" Width="*"/>
                                        <DataGridTextColumn Header="Outside team" Binding="{Binding OutOfTeam}" Width="95"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <!-- Campuses of the selected cluster: each can follow the cluster or have its own sub-region -->
                            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelectedCluster}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,2">
                                    <Run Text="Campuses in "/><Run Text="{Binding SelectedCluster.Name, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource HintStyle}"
                                           Text="&quot;Same as cluster&quot; follows the cluster's sub-region. Pick another sub-region (any region) to split the campus off — only that team's PMs can then be assigned to it."/>
                                <Border CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True" MaxHeight="240">
                                    <DataGrid Style="{StaticResource AppDataGridStyle}"
                                              CellStyle="{StaticResource DataGridCellStyle}"
                                              ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                              ItemsSource="{Binding CampusRows}" BorderThickness="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Campus" Binding="{Binding Name}" Width="90"/>
                                            <DataGridTextColumn Header="Sites" Binding="{Binding Sites}" Width="55"/>
                                            <DataGridTemplateColumn Header="Sub-region" Width="190" SortMemberPath="SubRegionKey">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding DataContext.CampusSubRegionOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  DisplayMemberPath="Name" SelectedValuePath="Id"
                                                                  SelectedValue="{Binding SubRegionKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  FontSize="12" Margin="0,2"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Governed by" Binding="{Binding Effective}" Width="150"/>
                                            <DataGridTextColumn Header="PM" Binding="{Binding Pm}" Width="*"/>
                                            <DataGridTextColumn Header="Outside team" Binding="{Binding OutOfTeam}" Width="95"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ═══ Conflicts ═══ -->
                <TabItem Header="{Binding ConflictsTab}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource HintStyle}"
                                   Text="Existing assignments that break the team rule — made before the teams were set up, or after a cluster's sub-region or a PM's PE changed. They still count, but can't be repeated. Reassign them on the Sites or Assignment page."/>
                        <Border Grid.Row="1" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
                            <DataGrid Style="{StaticResource AppDataGridStyle}"
                                      CellStyle="{StaticResource DataGridCellStyle}"
                                      ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                      ItemsSource="{Binding Conflicts}" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Cluster" Binding="{Binding Cluster}" Width="70"/>
                                    <DataGridTextColumn Header="Sub-region" Binding="{Binding SubRegion}" Width="90"/>
                                    <DataGridTextColumn Header="Assignment" Binding="{Binding What}" Width="200"/>
                                    <DataGridTextColumn Header="PM" Binding="{Binding Pm}" Width="150"/>
                                    <DataGridTextColumn Header="Why" Binding="{Binding Reason}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
