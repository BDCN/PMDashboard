<UserControl x:Class="PMDashboard.Views.WorkloadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">

    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Title + stats -->
            <RowDefinition Height="Auto"/>  <!-- KPI panel -->
            <RowDefinition Height="*"/>     <!-- Chart body -->
            <RowDefinition Height="Auto"/>  <!-- Bottom axis -->
        </Grid.RowDefinitions>

        <!-- ── Title + Stats ── -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Project Managers — Workload"
                           FontSize="22" FontWeight="Bold"
                           Foreground="#0F172A" FontFamily="Segoe UI Semibold"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding PmCount, StringFormat={}{0} PMs}"
                               FontSize="13" Foreground="#2563EB"/>
                    <TextBlock Text="  •  " FontSize="13" Foreground="#64748B"/>
                    <TextBlock Text="{Binding TotalClusters, StringFormat={}{0} clusters}"
                               FontSize="13" Foreground="#64748B"/>
                    <TextBlock Text="  •  " FontSize="13" Foreground="#64748B"/>
                    <TextBlock Text="{Binding TotalSites, StringFormat={}{0} assigned sites}"
                               FontSize="13" Foreground="#64748B"/>
                    <TextBlock Text="  •  " FontSize="13" Foreground="#64748B"/>
                    <TextBlock Text="{Binding TotalRomps, StringFormat={}{0} total ROMPs}"
                               FontSize="13" Foreground="#64748B"/>
                </StackPanel>
            </StackPanel>

            <!-- Card view sort — only meaningful (and only shown) in Card view -->
            <Border Grid.Column="1" Background="White" CornerRadius="8"
                    BorderBrush="#E2E8F0" BorderThickness="1" Padding="10,0"
                    VerticalAlignment="Center" Margin="0,0,10,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCardView}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Sort by:" FontSize="12" Foreground="#64748B"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox SelectedValuePath="Content" SelectedValue="{Binding CardSortBy, Mode=TwoWay}"
                              FontSize="12" BorderThickness="0" Background="Transparent"
                              VerticalContentAlignment="Center" MinWidth="140">
                        <ComboBoxItem Content="Region"/>
                        <ComboBoxItem Content="Clusters"/>
                        <ComboBoxItem Content="Sites"/>
                        <ComboBoxItem Content="ROMPs"/>
                        <ComboBoxItem Content="Total Assignments"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Chart / Card view toggle — segmented control, two-way via IsCardView -->
            <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="8" Padding="3"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RbChartView" GroupName="WorkloadViewMode"
                                 IsChecked="True" Click="RbChartView_Click">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="bg" CornerRadius="6" Padding="14,6">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Content" Value="Chart"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>
                    <RadioButton x:Name="RbCardView" GroupName="WorkloadViewMode"
                                 Click="RbCardView_Click">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="bg" CornerRadius="6" Padding="14,6">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Content" Value="Card"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── KPI Panel — hidden entirely in Site Count Only mode ── -->
        <Border Grid.Row="1" Background="White" CornerRadius="8"
                BorderBrush="#E2E8F0" BorderThickness="1"
                Padding="20,16" Margin="0,0,0,20">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCountMode}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <WrapPanel Orientation="Horizontal">

                <!-- ── Score-mode KPI cards (Overloaded / Near Full / Has Capacity) ── -->

                <!-- Overloaded -->
                <Border CornerRadius="6" Padding="16,10" Margin="0,0,12,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FEF2F2"/>
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScoreMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse Width="8" Height="8" Fill="#DC2626" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="OVERLOADED" FontSize="10" FontWeight="SemiBold" Foreground="#991B1B"/>
                        </StackPanel>
                        <TextBlock Text="{Binding OverloadedCount, StringFormat={}{0} PMs}"
                                   FontSize="22" FontWeight="Bold" Foreground="#DC2626"/>
                        <TextBlock Text="util &gt; overload threshold" FontSize="10" Foreground="#B91C1C" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Near Full -->
                <Border CornerRadius="6" Padding="16,10" Margin="0,0,12,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FFF7ED"/>
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScoreMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse Width="8" Height="8" Fill="#EA580C" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="NEAR FULL" FontSize="10" FontWeight="SemiBold" Foreground="#9A3412"/>
                        </StackPanel>
                        <TextBlock Text="{Binding NearFullCount, StringFormat={}{0} PMs}"
                                   FontSize="22" FontWeight="Bold" Foreground="#EA580C"/>
                        <TextBlock Text="nearfull ≤ util ≤ overload" FontSize="10" Foreground="#C2410C" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Has Capacity -->
                <Border CornerRadius="6" Padding="16,10" Margin="0,0,12,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#F0FDF4"/>
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScoreMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse Width="8" Height="8" Fill="#16A34A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="HAS CAPACITY" FontSize="10" FontWeight="SemiBold" Foreground="#166534"/>
                        </StackPanel>
                        <TextBlock Text="{Binding HasCapacityCount, StringFormat={}{0} PMs}"
                                   FontSize="22" FontWeight="Bold" Foreground="#16A34A"/>
                        <TextBlock Text="util &lt; nearfull threshold" FontSize="10" Foreground="#15803D" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ── Sites-mode KPI cards (Over Capacity / On Target / Under Target) ── -->

                <!-- Over capacity -->
                <Border CornerRadius="6" Padding="16,10" Margin="0,0,12,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FEF2F2"/>
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScoreMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse Width="8" Height="8" Fill="#DC2626" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="OVER CAPACITY" FontSize="10" FontWeight="SemiBold" Foreground="#991B1B"/>
                        </StackPanel>
                        <TextBlock Text="{Binding OverCapacityCount, StringFormat={}{0} PMs}"
                                   FontSize="22" FontWeight="Bold" Foreground="#DC2626"/>
                        <TextBlock Text="&gt; 100% utilization" FontSize="10" Foreground="#B91C1C" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- On target -->
                <Border CornerRadius="6" Padding="16,10" Margin="0,0,12,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#F0FDF4"/>
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScoreMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse Width="8" Height="8" Fill="#16A34A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="ON TARGET" FontSize="10" FontWeight="SemiBold" Foreground="#166534"/>
                        </StackPanel>
                        <TextBlock Text="{Binding OnTargetCount, StringFormat={}{0} PMs}"
                                   FontSize="22" FontWeight="Bold" Foreground="#16A34A"/>
                        <TextBlock Text="Ideal → 100%" FontSize="10" Foreground="#15803D" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Under target -->
                <Border CornerRadius="6" Padding="16,10" Margin="0,0,12,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#EFF6FF"/>
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScoreMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse Width="8" Height="8" Fill="#2563EB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="UNDER TARGET" FontSize="10" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                        </StackPanel>
                        <TextBlock Text="{Binding UnderTargetCount, StringFormat={}{0} PMs}"
                                   FontSize="22" FontWeight="Bold" Foreground="#2563EB"/>
                        <TextBlock Text="Below ideal utilization" FontSize="10" Foreground="#1E40AF" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- No capacity set (both modes) -->
                <Border Background="#F8FAFC" CornerRadius="6" Padding="16,10" Margin="0,0,12,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse Width="8" Height="8" Fill="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="NO CAPACITY SET" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                        </StackPanel>
                        <TextBlock Text="{Binding NoCapacityCount, StringFormat={}{0} PMs}"
                                   FontSize="22" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock Text="Capacity not configured" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Average utilization (both modes) -->
                <Border Background="#F0F9FF" CornerRadius="6" Padding="16,10" Margin="0,0,0,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse Width="8" Height="8" Fill="#0284C7" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="AVG UTILIZATION" FontSize="10" FontWeight="SemiBold" Foreground="#0369A1"/>
                        </StackPanel>
                        <TextBlock Text="{Binding AvgUtilizationText}"
                                   FontSize="22" FontWeight="Bold" Foreground="#0284C7"/>
                        <TextBlock Text="PMs with capacity set" FontSize="10" Foreground="#0369A1" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

            </WrapPanel>
        </Border>

        <!-- ── Chart Body ── -->
        <Border Grid.Row="2" CornerRadius="10,10,0,0" BorderBrush="#E2E8F0" BorderThickness="1,1,1,0"
                Background="White" ClipToBounds="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCardView}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="ChartGrid" ClipToBounds="True"
                      SizeChanged="ChartGrid_SizeChanged">

                    <!-- Background: faint grid lines + 100% reference line -->
                    <Canvas x:Name="BackgroundCanvas"
                            IsHitTestVisible="False"
                            Margin="150,0,0,0"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Left"/>

                    <!-- Bar rows -->
                    <ItemsControl x:Name="ChartRows" ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="42" Cursor="Hand"
                                      MouseLeftButtonUp="RowGrid_MouseLeftButtonUp">
                                    <Grid.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{Binding TooltipText}"
                                                       FontFamily="Segoe UI" FontSize="12"
                                                       LineHeight="18"/>
                                        </ToolTip>
                                    </Grid.ToolTip>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Row separator -->
                                    <Border Grid.ColumnSpan="2" BorderBrush="#F1F5F9"
                                            BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>

                                    <!-- PM Name (clickable link style) -->
                                    <TextBlock Grid.Column="0" Text="{Binding PmName}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Margin="0,0,12,0" FontSize="12" Foreground="#2563EB"
                                               FontFamily="Segoe UI" FontWeight="SemiBold"
                                               TextDecorations="Underline"/>

                                    <!-- Bars column: overlay grid so label can go inside or outside -->
                                    <Grid Grid.Column="1" VerticalAlignment="Center">

                                        <!-- Colored bar rectangles -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Rectangle Width="{Binding BlueWidth}"  Height="28"
                                                       Fill="#2563EB" SnapsToDevicePixels="True"/>
                                            <Rectangle Width="{Binding GreenWidth}" Height="28"
                                                       Fill="#16A34A" SnapsToDevicePixels="True"/>
                                            <Rectangle Width="{Binding RedWidth}"   Height="28"
                                                       Fill="#DC2626" SnapsToDevicePixels="True"/>
                                            <!-- OSA campuses (campus-level work with no sites) -->
                                            <Rectangle Width="{Binding OsaWidth}"   Height="28" SnapsToDevicePixels="True">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#34D399" Offset="0"/>
                                                        <GradientStop Color="#059669" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>

                                            <!-- Outside label — shown when utilization ≤ 80% -->
                                            <TextBlock Text="{Binding Label}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0" FontSize="11"
                                                       FontWeight="SemiBold" Foreground="#374151"
                                                       FontFamily="Segoe UI">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHighUtilization}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Inside label — shown when utilization > 80%, white text over bar -->
                                        <TextBlock Text="{Binding Label}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Left"
                                                   Margin="10,0,0,0" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="White"
                                                   FontFamily="Segoe UI">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHighUtilization}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </Grid>
            </ScrollViewer>
        </Border>

        <!-- ── Bottom Axis ── -->
        <Border Grid.Row="3" BorderBrush="#E2E8F0" BorderThickness="1,0,1,1"
                CornerRadius="0,0,10,10" Background="White" Padding="0,0,0,6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCardView}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>  <!-- name column spacer -->
                    <ColumnDefinition Width="*"/>    <!-- axis tick area -->
                </Grid.ColumnDefinitions>

                <!-- Axis label — "% Utilization" normally, "Assigned Campuses" in Count mode -->
                <TextBlock Grid.Column="0"
                           FontSize="10" FontWeight="SemiBold" Foreground="#64748B"
                           HorizontalAlignment="Right" VerticalAlignment="Top"
                           Margin="0,6,12,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="% Utilization"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCountMode}" Value="True">
                                    <Setter Property="Text" Value="Assigned Sites"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Tick marks + numbers -->
                <Canvas Grid.Column="1" Height="32" ClipToBounds="False">
                    <!-- Baseline -->
                    <Rectangle Canvas.Left="0" Canvas.Top="0"
                               Width="10000" Height="1" Fill="#E2E8F0"/>
                    <!-- Dynamic ticks from ViewModel -->
                    <ItemsControl ItemsSource="{Binding Ticks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top"  Value="0"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <!-- Tick mark: taller + darker for major, short + lighter for minor -->
                                    <Rectangle Fill="#94A3B8">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="Width"  Value="1"/>
                                                <Setter Property="Height" Value="4"/>
                                                <Setter Property="Fill"   Value="#CBD5E1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMajor}" Value="True">
                                                        <Setter Property="Height" Value="8"/>
                                                        <Setter Property="Fill"   Value="#6B7280"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                    <!-- Label only on major ticks (multiples of 50) -->
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="10" Foreground="#64748B"
                                               FontFamily="Segoe UI"
                                               Margin="-5,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Label}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </Grid>
        </Border>

        <!-- ── Card View — one tile per PM: Team - Name, Cluster/Campus/ROMP counts, then
             the list of clusters they're assigned into. Spans rows 2-3 so it gets the full
             height the chart+axis would otherwise use. ── -->
        <Border Grid.Row="2" Grid.RowSpan="2" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1"
                Background="#EEF1F5" ClipToBounds="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCardView}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <!-- WrapPanel for natural responsive reflow (width-based, no code-behind column
                     math needed) + Grid.IsSharedSizeScope/SharedSizeGroup so every card's height
                     still comes out uniform — each card sits in its own single-cell Grid whose
                     Auto row is tagged with the same SharedSizeGroup, which WPF resolves to the
                     tallest row among all of them and applies to every one. This is the
                     idiomatic WPF way to get "uniform to the largest" out of a wrapping layout;
                     a plain UniformGrid forces a strict N×M grid instead and (as seen in
                     practice) didn't actually keep every row visually uniform. -->
                <ItemsControl ItemsSource="{Binding CardRows}" Margin="16" Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,16,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" SharedSizeGroup="PmCardHeight"/>
                                </Grid.RowDefinitions>
                            <Border CornerRadius="10" BorderBrush="#94A3B8" BorderThickness="1.5"
                                    Background="White" Width="300" ClipToBounds="True">
                                <Border.Effect>
                                    <DropShadowEffect Color="#0F172A" Opacity="0.12"
                                                       BlurRadius="10" ShadowDepth="2" Direction="270"/>
                                </Border.Effect>
                                <StackPanel>
                                    <!-- Header strip: Team - PM Name. Unassigned PMs get a green
                                         gradient here instead of white, as an at-a-glance flag that
                                         this PM is carrying no clusters/campuses/ROMPs at all. -->
                                    <Border Padding="18,14,18,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="White"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasNoAssignments}" Value="True">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                    <GradientStop Color="#16A34A" Offset="0"/>
                                                                    <GradientStop Color="#86EFAC" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding PmName, StringFormat='Team - {0}'}"
                                                       FontSize="15" FontWeight="Bold" Foreground="#0F172A"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="No Assignments" FontSize="10" FontWeight="Bold"
                                                       Foreground="White" Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasNoAssignments}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Margin="18,12,18,16">
                                    <!-- Cluster / Campus / Site / ROMP counts (CampusCount = sites; RealCampusCount = campuses) -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding ClusterCount}" FontSize="22" FontWeight="Bold"
                                                       Foreground="#2563EB" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Clusters" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="#64748B" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding RealCampusCount}" FontSize="22" FontWeight="Bold"
                                                       Foreground="#7C3AED" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Campuses" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="#64748B" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding CampusCount}" FontSize="22" FontWeight="Bold"
                                                       Foreground="#16A34A" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Sites" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="#64748B" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="{Binding RompCount}" FontSize="22" FontWeight="Bold"
                                                       Foreground="#D97706" HorizontalAlignment="Center"/>
                                            <TextBlock Text="ROMPs" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="#64748B" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <Separator Background="#E2E8F0" Margin="0,0,0,10"/>

                                    <TextBlock Text="Assigned Clusters" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#374151" Margin="0,0,0,8"/>

                                    <!-- Bounded height + its own scroll area: a PM with a very large
                                         portfolio (hundreds of campuses/ROMPs) must not balloon this
                                         card's height, since SharedSizeGroup would then force every
                                         other card on the page to match it. -->
                                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                    <!-- One block per cluster this PM has campuses in -->
                                    <ItemsControl ItemsSource="{Binding Clusters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                            <Ellipse Width="5" Height="5" Fill="#94A3B8"
                                                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{Binding ClusterName}" FontSize="12"
                                                                       FontWeight="SemiBold" Foreground="#0F172A"/>
                                                            <TextBlock Text="{Binding Region, StringFormat=' ({0})'}"
                                                                       FontSize="11" Foreground="#94A3B8"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1"
                                                                   FontSize="11" Foreground="#64748B">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{Binding CampusCount, StringFormat='{}{0} site(s)'}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDirectAssignment}" Value="True">
                                                                            <Setter Property="Text" Value="Assigned directly — no sites yet"/>
                                                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>

                                                    <!-- Campuses under this cluster, each with its ROMPs listed beneath -->
                                                    <ItemsControl ItemsSource="{Binding Campuses}" Margin="13,4,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="0,0,0,4">
                                                                    <TextBlock Text="{Binding CampusName}" FontSize="11.5"
                                                                               FontWeight="Medium" Foreground="#1E293B"/>
                                                                    <TextBlock Text="{Binding RompNamesText}" FontSize="10.5"
                                                                               Foreground="#64748B" TextWrapping="Wrap"
                                                                               Margin="10,1,0,0"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </ScrollViewer>

                                    <!-- Empty state — no clusters assigned -->
                                    <TextBlock Text="No sites assigned" FontSize="12"
                                               Foreground="#94A3B8" FontStyle="Italic">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Clusters.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

    </Grid>
</UserControl>
